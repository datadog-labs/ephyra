diff --git a/brush-shell/tests/cases/compat/builtins/echo.yaml b/brush-shell/tests/cases/compat/builtins/echo.yaml
index 7081a4fa..44958b5c 100644
--- a/brush-shell/tests/cases/compat/builtins/echo.yaml
