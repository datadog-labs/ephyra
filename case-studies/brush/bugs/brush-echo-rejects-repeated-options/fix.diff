@@ -33,3 +33,18 @@ cases:
       shopt -s xpg_echo
       echo -n 'a\tb'
       echo -e 'c'
+
+  - name: "echo with repeated options"
+    stdin: |
+      echo -n -n a; echo
+      echo -e -e 'b\tc'
+      echo -nn d; echo
+      echo -n -e -n 'e\tf'; echo
+
+  - name: "echo -e and -E: last one wins"
+    stdin: |
+      echo -e -E 'a\tb'
+      echo -E -e 'c\td'
+      echo -eE 'e\tf'
+      echo -Ee 'g\th'
+      echo -enE 'i\tj'; echo
