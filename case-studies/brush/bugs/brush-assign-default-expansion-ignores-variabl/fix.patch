From e5236143d5484dc2da6942f9b5f49eef9fb25e91 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Alperen=20Kele=C5=9F?= <alpkeles99@gmail.com>
Date: Wed, 21 Oct 2026 09:16:12 -0400
Subject: [PATCH] fix(core): expand ${v:=word} to the value stored in v
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

When `v` is unset or null, `${v:=word}` assigns `word` to `v` and expands
to the new value of `v`. The `AssignDefaultValues` arm returned the expanded
word instead, so an attribute that changes the stored value (`declare -u`,
`-l`, `-c`, `-i`) was not reflected in the expansion: with `declare -u v`,
`echo "${v:=abc}"` printed `abc` where bash prints `ABC`.

Return the value of the parameter after the assignment.

Signed-off-by: Alperen Keleş <alpkeles99@gmail.com>
Assisted-by: Claude Code:claude-opus-5-5
---
 brush-core/src/expansion.rs | 39 +++++++++++++++++++++++++++----------
 1 file changed, 29 insertions(+), 10 deletions(-)

diff --git a/brush-core/src/expansion.rs b/brush-core/src/expansion.rs
index 7dce5d3f..94c4fc2e 100644
--- a/brush-core/src/expansion.rs
+++ b/brush-core/src/expansion.rs
@@ -644,7 +644,8 @@ pub async fn assign_to_named_parameter(
     let parser_options = shell.parser_options();
     let mut expander = WordExpander::new(shell, params);
     let parameter = brush_parser::word::parse_parameter(name, &parser_options)?;
-    expander.assign_to_parameter(&parameter, value).await
+    expander.assign_to_parameter(&parameter, value).await?;
+    Ok(())
 }
 
 struct WordExpander<'a, SE: extensions::ShellExtensions> {
@@ -1322,9 +1323,12 @@ impl<'a, SE: extensions::ShellExtensions> WordExpander<'a, SE> {
                     _ => {
                         let expanded_default = self.expand_parameter_word(default_value).await?;
                         let expanded_default_value = self.fields_to_string(expanded_default);
-                        self.assign_to_parameter(&parameter, expanded_default_value.clone())
+                        // The value substituted is the parameter's value after the assignment,
+                        // which may differ from the assigned word (e.g., `declare -u`).
+                        let assigned_value = self
+                            .assign_to_parameter(&parameter, expanded_default_value)
                             .await?;
-                        Ok(Expansion::from(expanded_default_value))
+                        Ok(Expansion::from(assigned_value))
                     }
                 }
             }
@@ -1771,11 +1775,13 @@ impl<'a, SE: extensions::ShellExtensions> WordExpander<'a, SE> {
         }
     }
 
+    /// Assigns the given value to the parameter, returning the parameter's resulting value
+    /// (after any transformations implied by the variable's attributes).
     async fn assign_to_parameter<T: Into<String>>(
         &mut self,
         parameter: &brush_parser::word::Parameter,
         value: T,
-    ) -> Result<(), error::Error> {
+    ) -> Result<String, error::Error> {
         let (variable_name, index) = match parameter {
             brush_parser::word::Parameter::Named(name) => (name, None),
             brush_parser::word::Parameter::NamedWithIndex { name, index } => {
@@ -1806,24 +1812,37 @@ impl<'a, SE: extensions::ShellExtensions> WordExpander<'a, SE> {
 
         let value = value.into();
 
-        if let Some(index) = index {
+        if let Some(index) = &index {
             self.shell.env_mut().update_or_add_array_element(
                 variable_name,
-                index,
-                value,
+                index.clone(),
+                value.clone(),
                 |_| Ok(()),
                 env::EnvironmentLookup::Anywhere,
                 env::EnvironmentScope::Global,
-            )
+            )?;
         } else {
             self.shell.env_mut().update_or_add(
                 variable_name,
-                variables::ShellValueLiteral::Scalar(value),
+                variables::ShellValueLiteral::Scalar(value.clone()),
                 |_| Ok(()),
                 env::EnvironmentLookup::Anywhere,
                 env::EnvironmentScope::Global,
-            )
+            )?;
         }
+
+        let assigned_value = match self.shell.env().get(variable_name) {
+            Some((_, var)) => match &index {
+                Some(index) => var
+                    .value()
+                    .get_at(index, self.shell)?
+                    .map(|v| v.into_owned()),
+                None => Some(var.value().to_cow_str(self.shell).into_owned()),
+            },
+            None => None,
+        };
+
+        Ok(assigned_value.unwrap_or(value))
     }
 
     async fn try_resolve_parameter_to_variable(
