diff --git a/brush-core/src/patterns.rs b/brush-core/src/patterns.rs
index 2564c6d..25df9a8 100644
--- a/brush-core/src/patterns.rs
+++ b/brush-core/src/patterns.rs
@@ -286,10 +286,14 @@ impl Pattern {
                     .set_extended_globbing(self.enable_extended_globbing)
                     .set_case_insensitive(self.case_insensitive);
 
+                // Skip empty pieces (e.g. from `""` or an empty expansion) so that
+                // a pattern like `"".*` is still recognized as starting with a dot.
                 let subpattern_starts_with_dot = subpattern
                     .pieces
-                    .first()
-                    .is_some_and(|piece| piece.as_str().starts_with('.'));
+                    .iter()
+                    .map(|piece| piece.as_str())
+                    .find(|s| !s.is_empty())
+                    .is_some_and(|s| s.starts_with('.'));
 
                 let allow_dot_files = !options.require_dot_in_pattern_to_match_dot_files
                     || subpattern_starts_with_dot;
