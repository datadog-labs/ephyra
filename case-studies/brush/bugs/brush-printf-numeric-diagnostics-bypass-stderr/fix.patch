+/// How a directive interprets an argument it consumes.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum ArgKind {
+    Text,
+    SignedInt,
+    UnsignedInt,
+    Float,
+}
+
+/// The arguments one directive consumes.
+struct DirectiveArgUses {
+    /// The arguments, in the order uucore consumes them (`*` width, `*` precision, then the
+    /// value), each with its explicit 1-based position (`N$`), if any.
+    uses: Vec<(Option<usize>, ArgKind)>,
+    /// Whether this is a `%b` directive, whose argument may contain a `\c` that stops output.
+    escaped_string: bool,
+}
+
+/// Returns the argument uses of each directive in the format string, in the order in which
+/// `parse_format_string` yields its `Spec` items.
+fn directive_arg_uses(format_string: &[u8]) -> Vec<DirectiveArgUses> {
+    let mut uses = vec![];
+    let mut rest = format_string;
+
+    // This walks the format string the same way `format::parse_spec_and_escape` does.
+    while let Some((c, tail)) = rest.split_first() {
+        match (c, tail.first()) {
+            // An escape consumes at least the following byte, and never a '%'.
+            (b'\\', Some(_)) => rest = &tail[1..],
+            (b'%', Some(b'%')) => rest = &tail[1..],
+            (b'%', _) => {
+                let mut spec_rest = tail;
+                if format::Spec::parse(&mut spec_rest).is_ok() {
+                    uses.push(spec_arg_uses(&tail[..tail.len() - spec_rest.len()]));
+                } else {
+                    // Only the q/Q directives that `parse_format_string` replaces with a bare
+                    // `%q` get here without failing the whole format string.
+                    uses.push(DirectiveArgUses {
+                        uses: vec![(None, ArgKind::Text)],
+                        escaped_string: false,
+                    });
+                }
+                rest = spec_rest;
+            }
+            _ => rest = tail,
+        }
+    }
+
+    uses
+}
+
+/// Returns the argument uses of a directive, given its text after the '%' (which uucore has
+/// already validated).
+fn spec_arg_uses(spec: &[u8]) -> DirectiveArgUses {
+    let (value_position, mut index) = eat_arg_position(spec, 0);
+
+    // Every '*' before the conversion character consumes a width or precision argument.
+    let mut uses = vec![];
+    while index + 1 < spec.len() {
+        if spec[index] == b'*' {
+            let (position, next) = eat_arg_position(spec, index + 1);
+            uses.push((position, ArgKind::SignedInt));
+            index = next;
+        } else {
+            index += 1;
+        }
+    }
+
+    let kind = match spec.last() {
+        Some(b'd' | b'i') => ArgKind::SignedInt,
+        Some(b'u' | b'o' | b'x' | b'X') => ArgKind::UnsignedInt,
+        Some(b'f' | b'F' | b'e' | b'E' | b'g' | b'G' | b'a' | b'A') => ArgKind::Float,
+        _ => ArgKind::Text,
+    };
+    uses.push((value_position, kind));
+
+    DirectiveArgUses {
+        uses,
+        escaped_string: spec.last() == Some(&b'b'),
+    }
+}
+
+/// Parses an `N$` argument position at `start`, returning it and the index after it.
+fn eat_arg_position(spec: &[u8], start: usize) -> (Option<usize>, usize) {
+    let digits = spec[start..]
+        .iter()
+        .take_while(|b| b.is_ascii_digit())
+        .count();
+    if digits > 0 && spec.get(start + digits) == Some(&b'$') {
+        let position = std::str::from_utf8(&spec[start..start + digits])
+            .ok()
+            .and_then(|s| s.parse().ok())
+            .unwrap_or(usize::MAX);
+        (Some(position), start + digits + 1)
+    } else {
+        (None, start)
+    }
+}
+
+/// Mirrors how `format::FormatArguments` selects the argument each directive consumes.
+#[derive(Default)]
+struct ArgCursor {
+    next_position: usize,
+    highest_position: Option<usize>,
+    offset: usize,
+}
+
+impl ArgCursor {
+    fn take(&mut self, position: Option<usize>) -> usize {
+        match position {
+            None => {
+                let index = self.next_position;
+                self.next_position += 1;
+                index
+            }
+            Some(position) => {
+                let index = position.saturating_sub(1).saturating_add(self.offset);
+                self.highest_position = Some(self.highest_position.map_or(index, |h| h.max(index)));
+                index
+            }
+        }
+    }
+
+    fn start_next_batch(&mut self) {
+        self.offset = self
+            .next_position
+            .max(self.highest_position.map_or(0, |h| h.saturating_add(1)));
+        self.next_position = self.offset;
+    }
+}
+
+/// Converts each argument that is only ever consumed as a number into a typed uucore argument,
+/// returning the arguments and, per argument, the error to report if it is not a valid number.
+fn convert_args(
+    args: &[impl AsRef<str>],
+    format_items: &[ParsedFormatItem],
+    arg_uses: &[DirectiveArgUses],
+) -> (Vec<format::FormatArgument>, Vec<Option<&'static str>>) {
+    // Find out how each argument is consumed, cycling through the format string the same way
+    // `format_via_uucore` does, including where a `\c` stops the current pass.
+    let mut kinds: Vec<Option<ArgKind>> = vec![None; args.len()];
+    let format_consumes_args = !arg_uses.is_empty();
+    let mut cursor = ArgCursor::default();
+    if format_consumes_args {
+        loop {
+            let mut directive_uses = arg_uses.iter();
+            for (item, _) in format_items {
+                let stop = if matches!(item, format::FormatItem::Spec(_)) {
+                    let Some(directive) = directive_uses.next() else {
+                        break;
+                    };
+                    let mut last_arg = None;
+                    for (position, kind) in &directive.uses {
+                        let index = cursor.take(*position);
+                        last_arg = args.get(index);
+                        if let Some(seen) = kinds.get_mut(index) {
+                            *seen = match *seen {
+                                Some(seen) if seen != *kind => Some(ArgKind::Text),
+                                _ => Some(*kind),
+                            };
+                        }
+                    }
+                    directive.escaped_string
+                        && last_arg.is_some_and(|arg| escaped_string_stops(arg.as_ref()))
+                } else {
+                    // Literal characters consume no arguments; only `\c` stops.
+                    matches!(
+                        item.write(std::io::sink(), &mut format::FormatArguments::new(&[])),
+                        Ok(ControlFlow::Break(()))
+                    )
+                };
+                if stop {
+                    break;
+                }
+            }
+
+            cursor.start_next_batch();
+            if cursor.offset >= args.len() {
+                break;
+            }
+        }
+    }
+
+    args.iter()
+        .zip(kinds)
+        .map(|(arg, kind)| {
+            let arg = arg.as_ref();
+            match kind {
+                Some(ArgKind::SignedInt) => {
+                    let (value, error) = parse_numeric_arg(arg);
+                    (format::FormatArgument::SignedInt(value), error)
+                }
+                Some(ArgKind::UnsignedInt) => {
+                    let (value, error) = parse_numeric_arg(arg);
+                    (format::FormatArgument::UnsignedInt(value), error)
+                }
+                Some(ArgKind::Float) => {
+                    let (value, error) = parse_numeric_arg::<ExtendedBigDecimal>(arg);
+                    (format::FormatArgument::Float(value), error)
+                }
+                Some(ArgKind::Text) | None => {
+                    (format::FormatArgument::Unparsed(OsString::from(arg)), None)
+                }
+            }
+        })
+        .unzip()
+}
+
+/// Returns whether formatting `arg` with `%b` stops output (i.e., it contains a `\c`).
+fn escaped_string_stops(arg: &str) -> bool {
+    let probe_args = [format::FormatArgument::Unparsed(OsString::from(arg))];
+    let mut spec: &[u8] = b"b";
+    format::Spec::parse(&mut spec).is_ok_and(|spec| {
+        matches!(
+            spec.write(
+                std::io::sink(),
+                &mut format::FormatArguments::new(&probe_args)
+            ),
+            Ok(ControlFlow::Break(()))
+        )
+    })
+}
+
+/// Parses a numeric printf argument, returning its value (the best possible one, even when the
+/// argument is invalid) and the error to report, if any.
+fn parse_numeric_arg<T>(arg: &str) -> (T, Option<&'static str>)
+where
+    T: ExtendedParser + From<u32> + Default,
+{
+    // Like bash, a leading quote yields the code of the character that follows it, silently
+    // ignoring anything after that character.
+    if let Some(rest) = arg.strip_prefix(['\'', '"']) {
+        let value = rest
+            .chars()
+            .next()
+            .map_or_else(T::default, |c| T::from(u32::from(c)));
+        return (value, None);
+    }
+
+    match T::extended_parse(arg) {
+        Ok(value) => (value, None),
+        Err(ExtendedParserError::Overflow(value) | ExtendedParserError::Underflow(value)) => {
+            (value, Some("Numerical result out of range"))
+        }
+        Err(ExtendedParserError::PartialMatch(value, _)) => (value, Some("invalid number")),
+        Err(ExtendedParserError::NotNumeric) => (T::default(), Some("invalid number")),
+    }
 }
 
