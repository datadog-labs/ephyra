+/// If `redirected`, displays an error from a compound command using the command's own
+/// (redirected) stderr, and marks it as reported so it is not displayed again as it
+/// propagates.
+fn report_redirected_error(
+    shell: &Shell<impl extensions::ShellExtensions>,
+    params: &ExecutionParameters,
+    redirected: bool,
+    result: Result<ExecutionResult, error::Error>,
+) -> Result<ExecutionResult, error::Error> {
+    match result {
+        Err(err) if redirected => {
+            let _ = shell.display_error(&mut params.stderr(shell), &err);
+            Err(err.into_reported())
+        }
+        other => other,
+    }
+}
