+    /// A tilde-prefix naming a directory-stack entry that does not exist is left unchanged.
+    /// Replaces such prefixes with their source text (keeping, e.g., the leading zero of
+    /// `~01`), which the parsed index no longer has.
+    fn keep_unexpandable_dir_stack_tildes(
+        &self,
+        word: &str,
+        pieces: &mut [brush_parser::word::WordPieceWithSource],
+    ) {
+        for piece in pieces {
+            if let brush_parser::word::WordPiece::TildeExpansion(tilde_expr) = &piece.piece
+                && matches!(
+                    tilde_expr,
+                    brush_parser::word::TildeExpr::NthDirFromTopOfDirStack { .. }
+                        | brush_parser::word::TildeExpr::NthDirFromBottomOfDirStack { .. }
+                )
+                && self.dir_stack_entry_for_tilde(tilde_expr).is_none()
+                && let Some(source) = word.get(piece.start_index..piece.end_index)
+            {
+                piece.piece = brush_parser::word::WordPiece::SingleQuotedText(source.to_owned());
+            }
+        }
+    }
+
+    /// Looks up the directory-stack entry named by a `~N`, `~+N` or `~-N` tilde-prefix.
+    fn dir_stack_entry_for_tilde(
+        &self,
+        tilde_expr: &brush_parser::word::TildeExpr,
+    ) -> Option<Cow<'_, str>> {
+        match tilde_expr {
+            brush_parser::word::TildeExpr::NthDirFromBottomOfDirStack { n } => {
+                let dir_stack_count = self.shell.directory_stack().len();
+
+                if let Some(dir) = self.shell.directory_stack().get(*n) {
+                    Some(dir.to_string_lossy())
+                } else if *n == dir_stack_count {
+                    Some(self.shell.working_dir().to_string_lossy())
+                } else {
+                    None
+                }
+            }
+            brush_parser::word::TildeExpr::NthDirFromTopOfDirStack { n, .. } => {
+                if *n == 0 {
+                    return Some(self.shell.working_dir().to_string_lossy());
+                }
+
+                let dir_stack_count = self.shell.directory_stack().len();
+                if dir_stack_count >= *n
+                    && let Some(dir) = self.shell.directory_stack().get(dir_stack_count - *n)
+                {
+                    return Some(dir.to_string_lossy());
+                }
+
+                None
+            }
+            _ => None,
+        }
+    }
+
     fn expand_tilde_expression(
         &self,
         tilde_expr: &brush_parser::word::TildeExpr,
