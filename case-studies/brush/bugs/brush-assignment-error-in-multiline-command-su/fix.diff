diff --git a/brush-core/src/commands.rs b/brush-core/src/commands.rs
index b234cd3..f19b718 100644
--- a/brush-core/src/commands.rs
+++ b/brush-core/src/commands.rs
@@ -849,10 +849,59 @@ async fn run_substitution_command(
     // TODO(source-info): review this
     let source_info = crate::SourceInfo::from("main");
 
-    // Handle the parse result using default shell behavior.
-    shell
-        .run_parsed_result(parse_result, &source_info, &params)
-        .await
+    let program = match parse_result {
+        Ok(program) => program,
+        // Handle the parse error using default shell behavior.
+        Err(_) => {
+            return shell
+                .run_parsed_result(parse_result, &source_info, &params)
+                .await;
+        }
+    };
+
+    // The substitution's commands run as a single unit: unlike a script, where a variable
+    // assignment or expansion error only abandons the current line, such an error aborts
+    // the rest of the substitution.
+    let mut result = ExecutionResult::success();
+    for command in &program.complete_commands {
+        result = match command.execute(&mut shell, &params).await {
+            Ok(result) => result,
+            Err(err) => {
+                let _ = shell.display_error(&mut params.stderr(&shell), &err);
+                let aborts = aborts_command_substitution(&err);
+                let result = err.into_result(&shell);
+                shell.set_last_exit_status(result.exit_code.into());
+                if aborts {
+                    return Ok(result);
+                }
+                result
+            }
+        };
+
+        shell.set_last_exit_status(result.exit_code.into());
+
+        if !result.is_normal_flow() {
+            break;
+        }
+    }
+
+    Ok(result)
+}
+
+/// Returns whether the error is a variable assignment or expansion error, which aborts
+/// the whole command substitution it occurs in.
+fn aborts_command_substitution(err: &error::Error) -> bool {
+    matches!(
+        err.kind(),
+        ErrorKind::ArrayIndexOutOfRange(_)
+            | ErrorKind::ReadonlyVariable
+            | ErrorKind::CannotAssignToSpecialParameter
+            | ErrorKind::AssigningListToArrayMember
+            | ErrorKind::EvalError(_)
+            | ErrorKind::BadSubstitution(_)
+            | ErrorKind::CheckedExpansionError(_)
+            | ErrorKind::ExpandingUnsetVariable(_)
+    )
 }
 
