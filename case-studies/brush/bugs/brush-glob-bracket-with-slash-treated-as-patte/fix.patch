From cf51ad31e2be5d201046408dbbad464678551379 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Alperen=20Kele=C5=9F?= <alpkeles99@gmail.com>
Date: Wed, 21 Oct 2026 09:16:16 -0400
Subject: [PATCH] fix(core): treat a word like [a/b] as a literal, not a
 pattern
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A bracket expression cannot contain `/`, so `[a/b]` is not a pattern and
bash leaves it as is even under nullglob. Since #1153, `Pattern::expand`
split the word at `/` into the literal components `[a` and `b]` and dropped
the word because no such path exists, so nullglob removed it.

Decide whether a word has a pattern per path component, after splitting
at `/`.

Signed-off-by: Alperen Keleş <alpkeles99@gmail.com>
Assisted-by: Claude Code:claude-opus-5-5
---
 brush-core/src/patterns.rs                    | 51 +++++++++++--------
 .../cases/compat/options/shopt-nullglob.yaml  |  7 +++
 2 files changed, 37 insertions(+), 21 deletions(-)

diff --git a/brush-core/src/patterns.rs b/brush-core/src/patterns.rs
index 2564c6d4..bcaa5900 100644
--- a/brush-core/src/patterns.rs
+++ b/brush-core/src/patterns.rs
@@ -178,29 +178,8 @@ impl Pattern {
         // the argument even when nullglob is enabled.
         if self.pieces.is_empty() {
             return Ok(PatternExpansionResult::NoGlob);
-
-        // Similarly, if we're *confident* the pattern doesn't require expansion, then we
-        // know there's a single expansion (before filtering).
-        } else if !self.pieces.iter().any(|piece| {
-            matches!(piece, PatternPiece::Pattern(_))
-                && requires_expansion(piece.as_str(), self.enable_extended_globbing)
-        }) {
-            let concatenated: String = self.pieces.iter().map(|piece| piece.as_str()).collect();
-
-            if let Some(filter) = path_filter
-                && !filter(Path::new(&concatenated))
-            {
-                // No globs, but the literal was filtered out. Return NoGlob
-                // (not Expanded) so that callers don't mistake this for a
-                // failed glob match (which would trigger failglob).
-                return Ok(PatternExpansionResult::NoGlob);
-            }
-
-            return Ok(PatternExpansionResult::Expanded(vec![concatenated]));
         }
 
-        tracing::debug!(target: trace_categories::PATTERN, "expanding pattern: {self:?}");
-
         let mut components: Vec<PatternWord> = vec![];
         for piece in &self.pieces {
             let mut split_result: VecDeque<_> = sys::fs::split_path_for_pattern(piece.as_str())
@@ -223,6 +202,36 @@ impl Pattern {
             }
         }
 
+        // Similarly, if we're *confident* the pattern doesn't require expansion, then we
+        // know there's a single expansion (before filtering). This is decided per path
+        // component: a bracket expression can't span a '/', so e.g. `[a/b]` contains no
+        // pattern and is taken literally (as in bash). An extglob group may contain a
+        // '/', so it is still checked on the whole piece.
+        if !components.iter().flatten().any(|piece| {
+            matches!(piece, PatternPiece::Pattern(_))
+                && requires_expansion(piece.as_str(), self.enable_extended_globbing)
+        }) && !self.pieces.iter().any(|piece| {
+            matches!(piece, PatternPiece::Pattern(_))
+                && self.enable_extended_globbing
+                && piece.as_str().contains('(')
+                && requires_expansion(piece.as_str(), self.enable_extended_globbing)
+        }) {
+            let concatenated: String = self.pieces.iter().map(|piece| piece.as_str()).collect();
+
+            if let Some(filter) = path_filter
+                && !filter(Path::new(&concatenated))
+            {
+                // No globs, but the literal was filtered out. Return NoGlob
+                // (not Expanded) so that callers don't mistake this for a
+                // failed glob match (which would trigger failglob).
+                return Ok(PatternExpansionResult::NoGlob);
+            }
+
+            return Ok(PatternExpansionResult::Expanded(vec![concatenated]));
+        }
+
+        tracing::debug!(target: trace_categories::PATTERN, "expanding pattern: {self:?}");
+
         // Check if the path appears to be absolute by inspecting the first component.
         // On Unix, a leading `/` produces an empty first component. On Windows, a
         // drive-letter prefix like `c:` is also recognized. The platform-specific
diff --git a/brush-shell/tests/cases/compat/options/shopt-nullglob.yaml b/brush-shell/tests/cases/compat/options/shopt-nullglob.yaml
index 6b0e70f8..a1a3faca 100644
--- a/brush-shell/tests/cases/compat/options/shopt-nullglob.yaml
+++ b/brush-shell/tests/cases/compat/options/shopt-nullglob.yaml
@@ -77,3 +77,10 @@ cases:
     stdin: |
       shopt -s nullglob
       echo "result:" nonexistent_dir/*/
+
+  - name: "nullglob does not affect bracket containing slash"
+    stdin: |
+      shopt -s nullglob
+      echo "result:" [s/x] [/] [!/] ./[a/b]c
+      shopt -s extglob
+      echo "result:" @(a/b)
