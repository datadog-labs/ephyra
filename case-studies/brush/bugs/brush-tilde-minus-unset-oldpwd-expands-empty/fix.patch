From 8c6ea4746e8ef28fbcdfcbe451024d7420cbe524 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Alperen=20Kele=C5=9F?= <alpkeles99@gmail.com>
Date: Wed, 21 Oct 2026 09:16:21 -0400
Subject: [PATCH] fix(core): leave ~- as is when OLDPWD has no value
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

`~-` is replaced by the value of OLDPWD if it is set. At startup OLDPWD is
declared without a value, and `env_str("OLDPWD")` returned `Some("")` for
it, so `~-` expanded to the empty string and `~-/x` to `/x`.

Treat an OLDPWD without a value as unset, so `~-` stays literal.

Signed-off-by: Alperen Keleş <alpkeles99@gmail.com>
Assisted-by: Claude Code:claude-opus-5-5
---
 brush-core/src/expansion.rs                              | 6 +++++-
 brush-shell/tests/cases/compat/word_expansion/tilde.yaml | 8 ++++++++
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/brush-core/src/expansion.rs b/brush-core/src/expansion.rs
index 7dce5d3f..b7fa191e 100644
--- a/brush-core/src/expansion.rs
+++ b/brush-core/src/expansion.rs
@@ -1172,7 +1172,11 @@ impl<'a, SE: extensions::ShellExtensions> WordExpander<'a, SE> {
                 Ok(self.shell.working_dir().to_string_lossy())
             }
             brush_parser::word::TildeExpr::OldWorkingDir => {
-                if let Some(old_pwd) = self.shell.env_str("OLDPWD") {
+                // Per bash, `~-` is only replaced if OLDPWD is set; a declared-but-unset
+                // OLDPWD (as at startup) leaves the tilde-prefix unchanged.
+                if self.shell.env().is_set("OLDPWD")
+                    && let Some(old_pwd) = self.shell.env_str("OLDPWD")
+                {
                     Ok(old_pwd)
                 } else {
                     Ok(Cow::Borrowed("~-"))
diff --git a/brush-shell/tests/cases/compat/word_expansion/tilde.yaml b/brush-shell/tests/cases/compat/word_expansion/tilde.yaml
index 1aa8d78f..767b114a 100644
--- a/brush-shell/tests/cases/compat/word_expansion/tilde.yaml
+++ b/brush-shell/tests/cases/compat/word_expansion/tilde.yaml
@@ -41,6 +41,14 @@ cases:
       D=~-
       echo "~- (without OLDPWD): ${D//${test_root}/TEST_ROOT}"
 
+  - name: "Tilde expansion: ~- with declared but unset OLDPWD"
+    stdin: |
+      unset OLDPWD
+      declare -x OLDPWD
+      echo ~- ~-/x
+      OLDPWD=
+      echo "[~-]" "[$(echo ~-)]"
+
   - name: "Tilde expansion: dir stack"
     stdin: |
       test_root=$(pwd)
