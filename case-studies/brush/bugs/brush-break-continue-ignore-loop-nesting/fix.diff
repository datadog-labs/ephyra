 impl<SE: extensions::ShellExtensions> Shell<SE> {
+    /// Returns the number of loops enclosing the command currently executing, not counting
+    /// loops in callers of the current function.
+    pub const fn loop_depth(&self) -> usize {
+        self.loop_depth
+    }
+
+    /// Puts the shell outside of any loop, as a `( ... )` subshell is: like bash (per POSIX
+    /// interpretation 842), it's not in the same execution environment as its loops.
+    pub(crate) const fn leave_loops(&mut self) {
+        self.loop_depth = 0;
+    }
+
     /// Increments the interactive line offset in the shell by the indicated number
     /// of lines.
     ///
