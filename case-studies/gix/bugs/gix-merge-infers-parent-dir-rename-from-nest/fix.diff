+/// Return `true` if the renamed child of the `(directory, child)` pairs has the same path relative to its directory on
+/// both sides, ignoring the file name of non-tree children as these may be renamed along with their directory.
+fn child_keeps_path_below_directory<T: Change>(
+    (src_dir, src_child): (&Item<T>, &Item<T>),
+    (dst_dir, dst_child): (&Item<T>, &Item<T>),
+    backing: &[u8],
+) -> bool {
+    let relative_dir = |dir: &Item<T>, child: &Item<T>| -> Option<Vec<u8>> {
+        let child_location = child.location(backing);
+        let relative = child_location
+            .strip_prefix(dir.location(backing).as_bytes())?
+            .strip_prefix(b"/")?;
+        Some(if child.change.entry_mode().is_tree() {
+            relative.to_owned()
+        } else {
+            relative.rfind_byte(b'/').map_or(&[][..], |idx| &relative[..idx]).to_owned()
+        })
+    };
+    matches!(
+        (relative_dir(src_dir, src_child), relative_dir(dst_dir, dst_child)),
+        (Some(src), Some(dst)) if src == dst
+    )
+}
