+#[test]
+fn reflog_of_sibling_branch() {
+    for (spec, kind_name, expected_entry) in [
+        ("@{u}@{1}", "Upstream", "1"),
+        ("r1@{upstream}@{0}", "Upstream", "0"),
+        ("r1@{push}@{42 +0030}", "Push", "42 +0030"),
+    ] {
+        let rec = parse(spec);
+
+        assert!(rec.kind.is_none());
+        assert_eq!(rec.sibling_branch[0].as_deref(), Some(kind_name));
+        assert_eq!(
+            rec.current_branch_reflog_entry[0].as_deref(),
+            Some(expected_entry),
+            "like git, the reflog lookup applies to the sibling branch"
+        );
+    }
+}
