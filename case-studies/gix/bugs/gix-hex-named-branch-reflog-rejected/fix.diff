+#[test]
+fn reflog_and_sibling_branch_of_hash_like_ref_name() {
+    for (spec, ref_name) in [
+        ("1234@{0}", "1234"),
+        ("1234@{42 +0030}", "1234"),
+        ("1234@{u}", "1234"),
+        ("abcd-dirty@{1}", "abcd-dirty"),
+        ("v1.2.3-0-g1234@{2}", "v1.2.3-0-g1234"),
+    ] {
+        let rec = parse(spec);
+        assert_eq!(
+            rec.get_ref(0),
+            ref_name,
+            "like git, names followed by `@{{…}}` are tried as references first as only these have reflogs and siblings"
+        );
+        assert_eq!(rec.prefix[0], None, "the name wasn't also tried as object prefix");
+        assert_eq!(rec.calls, 2, "first the ref, then the reflog entry or sibling branch");
+    }
+}
