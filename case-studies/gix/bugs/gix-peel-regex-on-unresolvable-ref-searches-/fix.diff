+#[test]
+fn regex_search_from_unresolvable_symbolic_ref_fails() -> TestResult {
+    let (repo, _keep) = crate::basic_rw_repo()?;
+    std::fs::write(repo.git_dir().join("HEAD"), b"ref: refs/heads/unborn\n")?;
+    std::fs::write(repo.git_dir().join("refs/heads/alias"), b"ref: refs/heads/missing\n")?;
+
+    for revspec in ["HEAD^{/.}", "@^{/.}", "alias^{/.}", "alias^{/!-x}"] {
+        assert!(
+            repo.rev_parse(revspec).is_err(),
+            "{revspec}: nothing is reachable from an unresolvable reference, so it must not search all references"
+        );
+    }
+    assert!(repo.rev_parse(":/.").is_ok(), "searching from all references still works");
+    Ok(())
+}
