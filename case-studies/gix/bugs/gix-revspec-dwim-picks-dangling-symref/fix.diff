+#[test]
+fn dangling_symbolic_refs_are_skipped_during_lookup() -> TestResult {
+    let fixture = gix_testtools::scripted_fixture_read_only("make_dangling_symref_revspecs.sh")?;
+    let repo = gix::open_opts(fixture.clone(), crate::restricted())?;
+    let baseline = std::fs::read(fixture.join("baseline.git"))?;
+    let mut lines = baseline.lines();
+    while let (Some(revspec), Some(id)) = (lines.next(), lines.next()) {
+        let expected = gix::ObjectId::from_hex(id)?;
+        assert_eq!(
+            parse_spec(revspec.to_str()?, &repo)?.single().map(gix::Id::detach),
+            Some(expected),
+            "{} skips the dangling symbolic ref like Git does",
+            revspec.as_bstr()
+        );
+    }
+    Ok(())
+}
