+#[test]
+fn nth_prior_checkout_to_annotated_tag_is_not_peeled() -> TestResult {
+    let fixture = gix_testtools::scripted_fixture_read_only("make_prior_checkout_annotated_tag.sh")?;
+    let repo = gix::open_opts(fixture.clone(), crate::restricted())?;
+    let baseline = std::fs::read(fixture.join("baseline.git"))?;
+    let mut lines = baseline.lines();
+    while let (Some(revspec), Some(id)) = (lines.next(), lines.next()) {
+        assert_eq!(
+            parse_spec(revspec.to_str()?, &repo)?.single().map(gix::Id::detach),
+            Some(gix::ObjectId::from_hex(id)?),
+            "{} resolves like Git does",
+            revspec.as_bstr()
+        );
+    }
+    Ok(())
