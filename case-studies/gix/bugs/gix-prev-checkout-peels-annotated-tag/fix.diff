@@ -0,0 +1,14 @@
+#!/usr/bin/env bash
+set -eu -o pipefail
+
+# A previous checkout name that now names an annotated tag resolves to the tag object, like `git rev-parse main`.
+git init -q -b main
+git commit -q --allow-empty -m initial
+git checkout -q -b topic
+git branch -q -D main
+git tag -a -m tag main HEAD
+
+for revspec in @{-1} @{-1}^{} main; do
+  printf '%s\n' "$revspec" >>baseline.git
+  git rev-parse --verify "$revspec" >>baseline.git
+done
