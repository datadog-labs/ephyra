+
+  # B replaces the directory `a` by renaming `c` onto it. As A still has a modified file in `a/`,
+  # the renamed file must be kept at a unique path next to A's directory instead of being lost.
+  git checkout B
+  git rm -rq a
+  git mv c a
+  git commit -m "rm a/ && mv c a"
