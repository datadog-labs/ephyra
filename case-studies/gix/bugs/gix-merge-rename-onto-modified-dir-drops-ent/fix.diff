+
+  git branch A
+  git branch B
+
+  git checkout A
+  write_lines 1 2 3 4 5 6 >a/b
+  git commit -am "'A' changes 'a/b'"
+
+  git checkout B
+  git rm -rq a
+  git mv l a
+  git commit -m "rm a/ && mv l a"
