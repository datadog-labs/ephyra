+impl Delegate<'_> {
+    fn is_dangling_symref(&self, r: &gix_ref::Reference) -> bool {
+        matches!(r.target, gix_ref::Target::Symbolic(_)) && r.clone().attach(self.repo).follow_to_object().is_err()
+    }
+
+    /// Like `git`, skip a dangling (or looping) symbolic ref matched by `name` and continue with the
+    /// remaining lookup rules after `matched`, returning the first one that resolves.
+    fn find_ref_after_dangling(&self, name: &BStr, matched: &BStr) -> Option<gix_ref::Reference> {
+        if name.starts_with(b"refs/") {
+            return None;
+        }
+        let candidates = ["refs/", "refs/tags/", "refs/heads/", "refs/remotes/"]
+            .iter()
+            .map(|prefix| {
+                let mut full = BString::from(*prefix);
+                full.extend_from_slice(name);
+                full
+            })
+            .chain(Some({
+                let mut full = BString::from("refs/remotes/");
+                full.extend_from_slice(name);
+                full.extend_from_slice(b"/HEAD");
+                full
+            }));
+        candidates
+            .skip_while(|full| full.as_bstr() != matched)
+            .skip(1)
+            .find_map(|full| {
+                let r = self.repo.refs.try_find(full.as_bstr()).ok()??;
+                (r.name.as_bstr() == full.as_bstr() && !self.is_dangling_symref(&r)).then_some(r)
+            })
+    }
+}
