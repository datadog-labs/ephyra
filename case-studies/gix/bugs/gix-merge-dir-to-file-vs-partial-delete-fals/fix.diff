+                                        matches!(ours.inner, Change::Deletion { .. })
+                                            && (ours.was_applied()
+                                                || (ours.is_pending()
+                                                    && matches!(
+                                                        their_tree.check_conflict(ours.inner.location()),
+                                                        Some(PossibleConflict::Match { change_idx })
+                                                            if same_effect(&their_changes[change_idx].inner, &ours.inner)
+                                                    )))
+                                    },
+                                )
+                            {
+                                apply_change(&mut editor, theirs, rewritten_location.as_ref().map(|t| &t.0))?;
+                                their_changes[theirs_idx].mark_applied();
+                                continue;
+                            }
                             // Example: the base has `dir/file`, ours modifies `dir/file`, and theirs replaces `dir`
                             // with a blob. Our index has descendants below `dir` but no change at `dir` itself. The
                             // normal conflict resolution keeps our directory and moves their blob to a unique path.
diff --git a/gix-merge/src/tree/utils.rs b/gix-merge/src/tree/utils.rs
index 202407cac..7bd7a7fd6 100644
--- a/gix-merge/src/tree/utils.rs
+++ b/gix-merge/src/tree/utils.rs
@@ -608,6 +608,29 @@ impl TreeNodes {
         .into()
     }
 
+    /// Return `true` if every change indexed below the tree node at `location` satisfies `predicate`,
+    /// or `false` if there is no such node.
+    pub fn all_changes_below(&self, location: &BStr, mut predicate: impl FnMut(usize) -> bool) -> bool {
+        let mut cursor = &self.0[0];
+        for component in to_components(location) {
+            match cursor.children.get(component).copied() {
+                Some(child_idx) => cursor = &self.0[child_idx],
+                None => return false,
+            }
+        }
+        let mut stack: Vec<usize> = cursor.children.values().copied().collect();
+        while let Some(idx) = stack.pop() {
+            let node = &self.0[idx];
+            if let Some(change_idx) = node.change_idx
+                && !predicate(change_idx)
+            {
+                return false;
+            }
+            stack.extend(node.children.values().copied());
+        }
+        true
+    }
+
     pub fn remove_existing_change(&mut self, location: &BStr) {
         self.remove_change_inner(location, true);
     }
