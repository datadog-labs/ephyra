 /// Perform a merge between `our_tree` and `their_tree`, using `base_tree` as merge-base.
 /// Note that `base_tree` can be an empty tree to indicate 'no common ancestor between the two sides'.
@@ -251,6 +253,33 @@ pub fn tree<'objects>(
                         // ours-change at `dir` itself. Handle such structural-only overlaps below.
                         let Some(ours_idx) = ours_idx else {
                             let candidate_ours_idx = candidate.change_idx();
+                            // Example: the base has `dir/a` and `dir/b`, ours deletes `dir/b`, and theirs replaces
+                            // `dir` with a blob, deleting `dir/b` as well. Once the shared deletion is applied, or if it
+                            // is still pending on both sides, nothing of ours below `dir` remains to conflict with their
+                            // blob, which then replaces `dir` cleanly.
+                            if candidate_ours_idx.is_none()
+                                && matches!(candidate, PossibleConflict::TreeToNonTree { .. })
+                                && our_tree.all_changes_below(
+                                    rewritten_location
+                                        .as_ref()
+                                        .map_or_else(|| theirs.source_location(), |(location, _)| location.as_bstr()),
+                                    |idx| {
