+impl crate::Repository {
+    /// Like [`branch_remote(…)`](Self::branch_remote()), but when pushing and no remote is configured for the branch,
+    /// fall back to the [default remote](Self::remote_default_name()) like `git push` does.
+    fn branch_remote_or_default(
+        &self,
+        short_branch_name: &BStr,
+        direction: remote::Direction,
+    ) -> Option<Result<crate::Remote<'_>>> {
+        if direction == remote::Direction::Push && self.branch_remote_name(short_branch_name, direction).is_none() {
+            let name = self.remote_default_name(direction)?;
+            return self.try_find_remote(name.as_bstr());
+        }
+        self.branch_remote(short_branch_name, direction)
+    }
+}
