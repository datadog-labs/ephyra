diff --git a/gix/src/repository/reference.rs b/gix/src/repository/reference.rs
index 4c0db3a06..0a3f1d265 100644
--- a/gix/src/repository/reference.rs
+++ b/gix/src/repository/reference.rs
@@ -169,7 +169,10 @@ impl crate::Repository {
         let head = self.find_reference("HEAD")?;
         Ok(match head.inner.target {
             Target::Symbolic(branch) => match self.find_reference(&branch) {
-                Ok(r) => crate::head::Kind::Symbolic(r.detach()),
+                Ok(r) => match self.unborn_symbolic_target(&r) {
+                    Some(unborn) => crate::head::Kind::Unborn(unborn),
+                    None => crate::head::Kind::Symbolic(r.detach()),
+                },
                 Err(err) if err.is_not_found() => crate::head::Kind::Unborn(branch),
                 Err(err) => return Err(err),
             },
@@ -181,6 +184,24 @@ impl crate::Repository {
         .attach(self))
     }
 
+    /// If `r` is a symbolic reference whose chain ends in a reference that doesn't exist yet, return that name,
+    /// just like `git` treats `HEAD -> refs/heads/a -> refs/heads/missing` as being on the unborn branch `missing`.
+    fn unborn_symbolic_target(&self, r: &Reference<'_>) -> Option<FullName> {
+        let mut target = r.inner.target.clone();
+        // Bounded to not loop forever on cycles, which remain errors when peeling.
+        for _ in 0..5 {
+            let Target::Symbolic(name) = target else {
+                return None;
+            };
+            match self.find_reference(&name) {
+                Ok(next) => target = next.inner.target,
+                Err(err) if err.is_not_found() => return Some(name),
+                Err(_) => return None,
+            }
+        }
+        None
+    }
+
     /// Resolve the `HEAD` reference, follow and peel its target and obtain its object id,
     /// following symbolic references and tags until a commit is found.
     ///
diff --git a/gix/tests/gix/repository/reference.rs b/gix/tests/gix/repository/reference.rs
index 1b089a7dc..f568d7147 100644
--- a/gix/tests/gix/repository/reference.rs
+++ b/gix/tests/gix/repository/reference.rs
@@ -253,4 +253,16 @@ mod head {
         assert!(head.referent_name().is_none());
         Ok(())
     }
+
+    #[test]
+    fn symbolic_chain_to_missing_branch_is_unborn() -> TestResult {
+        let (repo, _keep) = crate::basic_rw_repo()?;
+        std::fs::write(repo.git_dir().join("refs/heads/main"), "ref: refs/heads/missing\n")?;
+
+        let head = repo.head()?;
+        assert!(head.is_unborn(), "HEAD -> main -> missing is on the unborn branch 'missing', like in git");
+        assert_eq!(head.referent_name().expect("symbolic"), "refs/heads/missing");
+        assert_eq!(repo.head_tree_id_or_empty()?, repo.object_hash().empty_tree());
+        Ok(())
+    }
 }
