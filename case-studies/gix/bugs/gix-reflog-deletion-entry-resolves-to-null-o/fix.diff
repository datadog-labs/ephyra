+#[test]
+fn deletion_entries_resolve_to_the_current_value() -> gix_testtools::TestResult {
+    let fixture = gix_testtools::scripted_fixture_read_only("make_reflog_with_deletion.sh")?;
+    let repo = gix::open_opts(fixture, crate::restricted())?;
+    let head = repo.head_id()?.detach();
+    for spec in ["HEAD@{1}", "HEAD@{1}^{/fix}", "HEAD@{2000-01-02 12:00:00 +0000}"] {
+        assert_eq!(
+            parse_spec(spec, &repo)?.single(),
+            Some(head.attach(&repo)),
+            "{spec} selects an entry that deletes the ref, which like in Git ends the log at the current value"
+        );
+    }
+    Ok(())
+}
