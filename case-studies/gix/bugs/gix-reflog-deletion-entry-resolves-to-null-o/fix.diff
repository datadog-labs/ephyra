new file mode 100755
index 000000000..222e8f3df
--- /dev/null
+++ b/gix/tests/fixtures/make_reflog_with_deletion.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+set -eu -o pipefail
+
+# Deleting the checked-out branch records an entry with a null new id in HEAD's reflog.
+git init -q
+export GIT_COMMITTER_DATE="2000-01-01 00:00:00 +0000"
+git commit -q --allow-empty -m 'fix one'
+export GIT_COMMITTER_DATE="2000-01-02 00:00:00 +0000"
+git update-ref -d refs/heads/main
+export GIT_COMMITTER_DATE="2000-01-03 00:00:00 +0000"
+git commit -q --allow-empty -m 'fix two'
+
+# Bake Git's object IDs or failure exit codes into the shared revspec baseline format.
+function baseline() {
+  printf '%s\n' "$1" >>baseline.git
+  git rev-parse -q --verify "$1" >>baseline.git 2>/dev/null || echo $? >>baseline.git
+}
+
+for spec in 'HEAD@{0}' 'HEAD@{1}' 'HEAD@{1}^{/fix}' 'HEAD@{2000-01-02 12:00:00 +0000}'; do
+  baseline "$spec"
+done
