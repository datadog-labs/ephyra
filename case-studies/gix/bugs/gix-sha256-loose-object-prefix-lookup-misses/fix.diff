+    #[test]
+    fn short_hex_prefixes_find_sha256_objects() {
+        let objects_dir = gix_testtools::tempfile::tempdir().unwrap();
+        let hex = "abcd6ac64baf0082ea0cff6ee67034cb6b25a15b7f1114ca900bb567e440cafb";
+        std::fs::create_dir(objects_dir.path().join(&hex[..2])).unwrap();
+        std::fs::write(objects_dir.path().join(&hex[..2]).join(&hex[2..]), b"fake").unwrap();
+        let store = ldb_at_opts(objects_dir.path(), gix_hash::Kind::Sha256);
+        let oid = gix_hash::ObjectId::from_hex(hex.as_bytes()).unwrap();
+        for short in ["abcd", "abcd6ac", &hex[..40]] {
+            // Short prefixes parsed from hex are of kind SHA1 as their length doesn't tell them apart.
+            let prefix = gix_hash::Prefix::from_hex(short).unwrap();
+            for mut candidates in [None, Some(HashSet::default())] {
+                assert_eq!(
+                    store.lookup_prefix(prefix, candidates.as_mut()).unwrap(),
+                    Some(Ok(oid)),
+                    "{short}"
+                );
+            }
+        }
