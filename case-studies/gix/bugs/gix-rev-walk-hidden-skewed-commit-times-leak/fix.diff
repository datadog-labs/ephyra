+struct Paint {
+    /// The amount of commits painted `VISIBLE` but not `HIDDEN`.
+    visible_only: usize,
+    /// `true` if all painted commits have a generation number, so they are processed in topological order.
+    generation_ordered: bool,
+}
+
+impl Paint {
+    /// Add `flags` to `commit` and return `true` if that changed its flags.
+    fn add(&mut self, commit: &mut gix_revwalk::graph::Commit<PaintFlags>, flags: PaintFlags) -> bool {
+        if (commit.data & flags) == flags {
+            return false;
+        }
+        let is_visible_only = |f: PaintFlags| f & (PaintFlags::VISIBLE | PaintFlags::HIDDEN) == PaintFlags::VISIBLE;
+        let was_visible_only = is_visible_only(commit.data);
+        commit.data |= flags;
+        match (was_visible_only, is_visible_only(commit.data)) {
+            (false, true) => self.visible_only += 1,
+            (true, false) => self.visible_only -= 1,
+            _ => {}
+        }
+        if commit.generation.is_none() {
+            self.generation_ordered = false;
+        }
+        true
+    }
+}
