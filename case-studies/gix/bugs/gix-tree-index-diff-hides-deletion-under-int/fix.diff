     Ok(())
 }
 
+#[test]
+fn intent_to_add_over_existing_entry_is_a_deletion() -> TestResult {
+    let (lhs, mut rhs, _, _, mut pathspec) = repo_with_indices("r4-base", "r4-base", None)?;
+    let idx = rhs
+        .entry_index_by_path("src/shared.rs".into())
+        .expect("entry is present");
+    rhs.entries_mut()[idx]
+        .flags
+        .insert(gix_index::entry::Flags::INTENT_TO_ADD);
+
+    let mut out = Vec::new();
+    gix_diff::index(
+        &lhs,
+        &rhs,
+        |change| -> gix_error::Result<_> {
+            out.push(change.into_owned());
+            Ok(std::ops::ControlFlow::Continue(()))
+        },
+        None::<gix_diff::index::RewriteOptions<'_, gix_object::find::Never>>,
+        &mut pathspec,
+        &mut |_, _, _, _| false,
+    )?;
+    assert_eq!(out.len(), 1, "Git sees intent-to-add entries as absent: {out:?}");
+    assert!(
+        matches!(&out[0], Change::Deletion { location, .. } if location.as_ref() == "src/shared.rs"),
+        "{out:?}"
+    );
+    Ok(())
+}
