 )
 
+git init modify-vs-type-change-to-gitlink
+(cd modify-vs-type-change-to-gitlink
+  write_lines 1 >a
+  git add . && git commit -m "original file"
+  gitlink="$(git rev-parse HEAD)"
+
+  git branch A
+  git branch B
+
+  # A turns the file into a gitlink while B edits it: Git keeps the gitlink at `a` and moves the
+  # edited file to `a~B` ("distinct types").
+  git checkout A
+  git rm -q --cached a && rm a
+  git update-index --add --cacheinfo "160000,$gitlink,a"
+  git commit -m "file to gitlink"
+
+  git checkout B
+  write_lines 2 >a
+  git commit -am "edit file"
+)
+
+git init modify-vs-type-change-to-symlink
+(cd modify-vs-type-change-to-symlink
+  write_lines 1 >a
+  git add . && git commit -m "original file"
+
+  git branch A
+  git branch B
+
+  # A turns the file into a symlink while B edits it: Git keeps the symlink at `a` and moves the
+  # edited file to `a~B`.
+  git checkout A
+  rm a && ln -s target a
+  git add a && git commit -m "file to symlink"
+
+  git checkout B
+  write_lines 2 >a
+  git commit -am "edit file"
+)
+
+git init type-change-to-symlink-vs-gitlink
