+  git checkout A
+  rm a && ln -s target a
+  git add a && git commit -m "file to symlink"
+
+  git checkout B
+  git rm -q --cached a && rm a
+  git update-index --add --cacheinfo "160000,$gitlink,a"
+  git commit -m "file to gitlink"
+)
+
