+
+/// Gives a destroyed tree's free pages back to its allocator when dropped,
+/// on unwind too.
+struct DeallocateFree<'t, A: Allocator> {
+    free: &'t mut FreeLists,
+    alloc: &'t A,
+    leaf: Layout,
+    internal: Layout,
+}
+
+impl<A: Allocator> Drop for DeallocateFree<'_, A> {
+    fn drop(&mut self) {
+        self.free.deallocate_all(self.alloc, self.leaf, self.internal);
     }
 }
