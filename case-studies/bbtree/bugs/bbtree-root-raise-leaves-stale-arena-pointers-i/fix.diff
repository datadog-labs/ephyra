+    /// Zeros the page's bytes from past its header, latch word included, up
+    /// to `end`, as a fresh page holds them: what a node of another kind
+    /// left there, and `initialize` doesn't overwrite, goes.
+    ///
+    /// # Safety
+    ///
+    /// The page is allocated with at least `end` bytes, the access is
+    /// exclusive, and nothing in those bytes needs dropping or freeing
+    /// anymore.
+    pub(super) unsafe fn zero_past_header(self, end: usize) {
+        let start = if Self::is_latched() {
+            size_of::<LatchedNodeHeader>()
+        } else if Self::has_inline_keys() {
+            size_of::<InlineKeyNodeHeader>()
+        } else {
+            size_of::<NodeHeader>()
+        };
+        // SAFETY: the bytes lie in the allocated page, which the caller has
+        // exclusive access to; the latch word, before `start`, is untouched.
+        unsafe { self.page().as_ptr().add(start).write_bytes(0, end - start) };
+    }
+
