@@ -241,3 +241,22 @@ fn an_empty_map_round_trips() {
     assert_eq!(disk.get(&1), None);
     assert_eq!(disk.iter().count(), 0);
 }
+
+/// The same entries make the same file, wherever the writer's arena lay:
+/// a root page that held a leaf of large values keeps no pointer to them.
+#[test]
+fn files_depend_on_the_entries_alone() {
+    let map: BTreeMap<[u8; 20], String> = (0..180u32)
+        .map(|number| {
+            let mut key = [0; 20];
+            key[..4].copy_from_slice(&number.to_be_bytes());
+            (key, "v".repeat((number as usize * 7919) % 5000))
+        })
+        .collect();
+    let (first, second) = (TestFile::new("first"), TestFile::new("second"));
+    BBTreeMapFile::<[u8; 20], String>::create(&first.0, &map).unwrap();
+    let elsewhere: Vec<Vec<u8>> = (0..5).map(|i| vec![i; 256 << i]).collect();
+    BBTreeMapFile::<[u8; 20], String>::create(&second.0, &map).unwrap();
+    drop(elsewhere);
+    assert!(std::fs::read(&first.0).unwrap() == std::fs::read(&second.0).unwrap());
+}
