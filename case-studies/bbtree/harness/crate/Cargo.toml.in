[package]
name = "bbz"
version = "0.0.0"
edition = "2024"
publish = false

[dependencies]
bbtree = { path = "@SRC@/bbtree", features = ["file"] }
bbtree-mmap = { path = "@SRC@/bbtree-mmap" }
bbtree-store = { path = "@SRC@/bbtree-store" }
ephyra = { path = "@EPHYRA@/crates/ephyra", default-features = false }
# the WAL oracle decodes the documented layout itself
crc32c = "0.6"
serde = { version = "1", features = ["derive"] }
# u128 keys: Value numbers past u64
serde_json = { version = "1", features = ["arbitrary_precision"] }

[workspace]

[lints.rust]
# bbtree's invariant checks (check_invariants, check_prefix_lens) are
# compiled under --cfg fuzzing, which build.sh sets.
unexpected_cfgs = { level = "allow" }

# release + debug assertions (bbtree has many) + overflow checks, no LTO
[profile.fuzz]
inherits = "release"
debug-assertions = true
overflow-checks = true
lto = false
# Incremental, codegen units left to it: a new fix or a merged round rebuilt every binary
# from scratch (plain 15 min, ASan 30, chaos 25, coverage 20; nothing searched meanwhile).
# Measured on an ASan build (2026-10-27): a bbtree change rebuilds in 11 min, a harness
# change in 32 s. Cost: tight inlined loops run slower (filemap 57%, store 96% of before).
incremental = true
debug = "line-tables-only"
