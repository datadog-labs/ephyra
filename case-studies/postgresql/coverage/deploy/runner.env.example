# Settings for start-run.sh, watchdog.sh, build-pg.sh and refresh-master.sh.
# Copy to runner.env (or point RUNNER_ENV at another file) and adjust.

# Where run directories live; RUN_ROOT/current is the run in progress. Keep
# it short: the cluster's socket, RUN_ROOT/<date>-postgresql-<commit>/pg/
# .s.PGSQL.5432, must stay under 100 bytes (start-run.sh checks).
RUN_ROOT="$HOME/fuzz-runs"

# Worker processes (each one session on the run's cluster, so a backend
# each). A worker and its backend share about one core between them; 14 on
# a 16-vCPU host leaves room for the supervisor, cron and a metrics agent.
WORKERS=14

# How long a run lasts (hours); the nightly master refresh starts a new run
# sooner when master moves.
HOURS=168

# Identity carried by every record and metric.
CAMPAIGN="postgresql/campaign/runner"
TAG="postgresql/campaign/runner"

# DogStatsD listener (README.md, "Metrics"); empty for none.
STATSD=""
TAGS="env:fuzz"

# Per-process memory limit (MB) the supervisor enforces by polling RSS
# every 500 ms (workers and the cluster's client backends), and the
# heartbeat limit (seconds) after which a worker is a hang.
MAX_RSS_MB=4096
STALE_SECS=300

# Hard address-space limit (MB, RLIMIT_AS via `ulimit -v`) the watchdog sets
# on the supervisor and so on everything it starts: workers, pg_ctl, the
# postmaster and every backend. Polling overshoots by up to a gigabyte on a
# query growing at >1 GB/s; under this limit such a query fails with "out
# of memory" instead. Above MAX_RSS_MB so that slow growth is still a
# memory_kill record. Linux only (macOS ignores it); empty for none.
MEM_LIMIT_MB=6144

# PostgreSQL: the master clone build-pg.sh fetches, and where builds go
# (PG_BUILDS/<commit12>/, a git worktree of PG_SRC with its install in
# inst/; PG_BUILDS/current is the one new runs use). Builds kept by
# refresh-master.sh: the current one and the newest KEEP_BUILDS.
PG_SRC="$HOME/postgres"
PG_BUILDS="$HOME/pg-builds"
PG_REPO="https://git.postgresql.org/git/postgresql.git"
KEEP_BUILDS=3
# Parallel make jobs (empty: the number of cores).
MAKE_JOBS=""

# What new runs test: master (PG_BUILDS/current) or fixed (PG_BUILDS/fixed,
# build-fixed.sh's master with every open known bug's fix applied, rebuilt
# by refresh-master.sh on each new master), so that runs stop rediscovering
# known bugs.
PG_TARGET=master

# Binaries for new runs instead of PG_BUILDS/current (a directory
# <checkout>/inst/bin, so that the run's target names the checkout's
# commit); empty to use PG_BUILDS/current.
PG_BIN=""

# refresh-master.sh moves to a new master only when ephyra-postgresql's
# tests pass on it; 1 to move anyway (the failures are logged).
SWITCH_ON_TEST_FAILURE=0
