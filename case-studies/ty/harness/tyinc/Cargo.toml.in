# build.sh substitutes @SRC@ (the ruff checkout under test) and copies its Cargo.lock.
[package]
name = "tyinc"
version = "0.1.0"
edition = "2024"

[workspace]

[dependencies]
ruff_db = { path = "@SRC@/crates/ruff_db", default-features = false, features = ["os", "cache"] }
ruff_python_ast = { path = "@SRC@/crates/ruff_python_ast" }
ruff_text_size = { path = "@SRC@/crates/ruff_text_size" }
ty_project = { path = "@SRC@/crates/ty_project", features = ["zstd"] }
ty_ide = { path = "@SRC@/crates/ty_ide" }
serde_json = "1"
# Only to recognise `salsa::Cancelled` payloads; resolves to the version in ruff's Cargo.lock.
salsa = { version = "*", default-features = false }

[profile.release]
lto = false
codegen-units = 16
debug-assertions = true
overflow-checks = true
