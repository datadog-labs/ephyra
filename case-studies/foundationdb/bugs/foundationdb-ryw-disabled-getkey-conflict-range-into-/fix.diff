+void Transaction::clipExtraReadConflictRanges(size_t from, Key end) {
+	for (size_t i = from; i < extraConflictRanges.size(); ++i) {
+		extraConflictRanges[i] = map(extraConflictRanges[i], [end](std::pair<Key, Key> const& r) {
+			return std::make_pair(std::min(r.first, end), std::min(r.second, end));
+		});
+	}
+}
