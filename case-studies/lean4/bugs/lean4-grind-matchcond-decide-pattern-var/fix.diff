@@ -0,0 +1,25 @@
+/-!
+`grind` must not refute a `match`-condition equality between a literal and a pattern
+variable by `decide` when it builds the proof of the condition.
+-/
+
+def f0 (x : Nat) : Nat :=
+  match (x, 1) with
+  | (a, 0) => a
+  | _ => 7
+
+example : f0 3 = 7 := by grind [f0]
+
+def f1 (s : Nat × Bool) : Nat :=
+  match s with
+  | (_, true) => 0
+  | _ => 1
+
+example : f1 (3, false) = 1 := by grind [f1]
+
+def f2 (x : Nat) (y : UInt8) : Nat :=
+  match (x, y) with
+  | (a, 0) => a
+  | _ => 7
+
+example : f2 3 1 = 7 := by grind [f2]
