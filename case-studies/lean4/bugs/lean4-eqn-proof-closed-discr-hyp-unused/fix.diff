index 0000000000..112645b7e3
--- /dev/null
+++ b/tests/elab/eqnsClosedDiscrInjection.lean
@@ -0,0 +1,20 @@
+/-!
+Equation lemmas for a `match` whose discriminant becomes closed once another discriminant is
+split (`5 - a` with `a := 0`): the proof must use the hypothesis `5 - 0 = n.succ` after the
+`match` reduces.
+-/
+
+def h (a : Nat) : Nat := match 5 - a, a with | 0, _ => 1 | n+1, 0 => n | _, _+1 => 3
+
+/-- info: h.eq_2 (n : Nat) : 5 - 0 = n.succ → h 0 = n -/
+#guard_msgs in #check h.eq_2
+
+def g (a : Nat) : StateM Nat Nat := do
+  match 65535 % a, a with
+  | 0, _ => pure ()
+  | n+1, 0 => set n
+  | _, _+1 => pure ()
+  return 0
+
+example (n : Nat) (h : 65535 % 0 = n.succ) : g 0 = (do set n; return 0) := by
+  rw [g.eq_2 n h]
