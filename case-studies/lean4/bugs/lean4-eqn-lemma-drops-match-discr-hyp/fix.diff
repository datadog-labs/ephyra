diff --git a/tests/elab/eqnsNonVarDiscrHyp.lean b/tests/elab/eqnsNonVarDiscrHyp.lean
new file mode 100644
index 0000000000..11c27273d8
--- /dev/null
+++ b/tests/elab/eqnsNonVarDiscrHyp.lean
@@ -0,0 +1,23 @@
+/-!
+Equation lemmas for a `match` on a non-variable discriminant keep the hypothesis
+`id 0 = n.succ` (or `7 - 0 = 0`) of an alternative even when it mentions no variable of its conclusion.
+-/
+
+def f (a : Nat) : Nat := match id a, a with | 0, _ => 1 | _+1, 0 => 2 | _, _+1 => 3
+
+/-- info: f.eq_2 (n : Nat) : id 0 = n.succ → f 0 = 2 -/
+#guard_msgs in #check f.eq_2
+
+def g (a : Nat) : StateM Nat Nat := do
+  match a / a, a with
+  | 0, _ => set 0
+  | _+1, 0 => pure ()
+  | _, _+1 => pure ()
+  return 0
+
+example (a : Nat) : g a = g a := by simp only [g]
+
+def h (a : Nat) : Nat := match 7 - 0, a with | 0, _ => 1 | _+1, 0 => 2 | _, _+1 => 3
+
+/-- info: h.eq_1 (a✝ : Nat) : 7 - 0 = 0 → h a✝ = 1 -/
+#guard_msgs in #check h.eq_1
