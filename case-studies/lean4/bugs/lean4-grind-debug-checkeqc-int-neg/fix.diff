index 4e653ec56a..b2087917fa 100644
--- a/src/Lean/Meta/Tactic/Grind/Internalize.lean
+++ b/src/Lean/Meta/Tactic/Grind/Internalize.lean
@@ -563,6 +563,13 @@ private def getLitKind (e : Expr) : MetaM LitKind := do
   | Char.ofNat n => return if (← isNatValue n) then .nonParametric else .notLit
   | _ => return .notLit
 
+/--
+Returns `true` if `internalize` handles `e` as a literal (see `getLitKind`).
+Such terms are not added to the congruence table.
+-/
+def isInternalizedAsLiteral (e : Expr) : MetaM Bool :=
+  return !(← getLitKind e) matches .notLit
+
 /--
