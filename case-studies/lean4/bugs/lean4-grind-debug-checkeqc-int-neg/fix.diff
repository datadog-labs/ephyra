-    -- Check congruence root
-    if curr.isApp then
+    -- Check congruence root.
+    -- Literals are not in the congruence table (see `internalizeNonParametricLiteral`), but a lookup
+    -- may find a term congruent to them, e.g., `-x` for the `Int8` literal `-1` after `x = 1`.
+    if curr.isApp && !(← isInternalizedAsLiteral curr) then
       if let some { e } := (← get).congrTable.find? { e := curr } then
         if (← hasSameType e.getAppFn curr.getAppFn) then
           assert! isSameExpr e (← getCongrRoot curr)
diff --git a/tests/elab/grind_debug_neg_lit_congr.lean b/tests/elab/grind_debug_neg_lit_congr.lean
new file mode 100644
index 0000000000..6565bb3c39
--- /dev/null
+++ b/tests/elab/grind_debug_neg_lit_congr.lean
@@ -0,0 +1,13 @@
+/-!
+Negative literals of signed fixed-width types such as `(-1 : Int8)` are internalized as literals
+and are not added to the congruence table. After `x = 1`, a congruence table lookup for `-1`
+finds `-x`, and the `grind.debug` invariant checker used to fail on it.
+-/
+
+set_option grind.debug true
+
+example (x : Int8) (h : x = 1) : -x = -1 := by grind
+example (x : Int16) (h : x = 1) : -x = -1 := by grind
+example (x : Int8) (h : x = 100) : -x = -100 := by grind
+example (x : Int8) (f : Int8 → Nat) (h : x = 1) : f (-x) = f (-1) := by grind
+example (x1 : Int32) : x1 = 8 → -x1 = -8 := by grind
