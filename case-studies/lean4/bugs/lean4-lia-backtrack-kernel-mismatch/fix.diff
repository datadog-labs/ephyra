+/--
+Rolls the cutsat state back to `saved`, the state of a case split, but keeps the variables
+created after it, without constraints. The conflict proof being resolved may use them (e.g., the
+variable of an omega step, see `EqCnstr.elimNonUnit`), and it is used after backtracking.
+-/
+private def restoreCase (saved : State) : GoalM Unit := do
+  modify' fun s => Id.run do
+    if s.vars.size == saved.vars.size || s.varsHistory.size != saved.varsHistory.size then
+      return saved
+    let mut r := { saved with vars := s.vars, varMap := s.varMap }
+    for _ in [saved.vars.size:s.vars.size] do
+      r := { r with
+        dvds    := r.dvds.push none
+        lowers  := r.lowers.push {}
+        uppers  := r.uppers.push {}
+        diseqs  := r.diseqs.push {}
+        occurs  := r.occurs.push {}
+        elimEqs := r.elimEqs.push none
+      }
+    return r
+
