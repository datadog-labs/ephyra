diff --git a/src/Lean/Environment.lean b/src/Lean/Environment.lean
index 297985fbec..9f21635efa 100644
--- a/src/Lean/Environment.lean
+++ b/src/Lean/Environment.lean
@@ -2450,8 +2450,11 @@ private def ImportedModule.irData? (self : ImportedModule) (loadIRSig : Bool :=
     -- leanir: for `import all` modules, use `.ir`; otherwise prefer `.ir.sig`
     if !loadIRSig || self.importAll then
       self.irParts.back?.map (·.1)
-    else
-      self.irParts[0]?.map (·.1)
+    else match self.irParts[0]? with
+      -- A module compiled without `compiler.postponeCompile` only has the placeholder `.ir.sig`
+      -- written by `writeModule`; its exported `.olean` part carries the same signature IR.
+      | some (sig, _) => if sig.isModule then some sig else self.mainModule?
+      | none => self.mainModule?
 
 structure ImportState where
   private moduleNameMap : Std.HashMap Name ImportedModule := {}
diff --git a/tests/lake/tests/moduleCodegen/Plain/P.lean b/tests/lake/tests/moduleCodegen/Plain/P.lean
index 57e1d1a67c..3fc39e0734 100644
--- a/tests/lake/tests/moduleCodegen/Plain/P.lean
+++ b/tests/lake/tests/moduleCodegen/Plain/P.lean
@@ -1,3 +1,10 @@
 module
 
 public def pVal : Nat := 100
+
+@[specialize] private def pGo (f : Nat → Nat) : Nat → Nat → Nat
+  | 0, acc => acc
+  | n+1, acc => pGo f n (f acc)
+
+-- inlining this into a postponed module needs `pGo`'s IR from `P`, which has no `leanir` `.ir.sig`
+@[inline] public def pIter (f : Nat → Nat) (n : Nat) : Nat := pGo f n 0
