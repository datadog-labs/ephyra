@@ -0,0 +1,12 @@
+/-!
+Equation lemma types are computed by `realizeValue`, which discards its environment changes. When
+the type mentions match equations realized while computing it (here, in the cast of the proof
+argument of `Nat.divExact` after the `match` is reduced), they must still reach the kernel
+environment before the equation lemma does.
+-/
+
+def f (_u : Unit) : Nat :=
+  let r := (match (0 : Nat) with | 0 => 1 | _ => 3)
+  Nat.divExact (4 * r) r (Nat.dvd_mul_left r 4)
+
+theorem t : f () = 4 := by simp [f]
