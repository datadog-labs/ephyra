diff --git a/tests/compile/noClosedLitBorrow.lean b/tests/compile/noClosedLitBorrow.lean
new file mode 100644
index 0000000000..3e0de95dd5
--- /dev/null
+++ b/tests/compile/noClosedLitBorrow.lean
@@ -0,0 +1,24 @@
+/-!
+Without closed term extraction, string and big `Nat` literals are fresh allocations. Borrow
+inference must treat them as owned: here they are passed to a join point whose body also
+consumes the `""` literal, so a borrowed join point parameter would be used after free.
+-/
+set_option compiler.extract_closed false
+
+@[noinline] def mk (_s : String) (n : Nat) : List Nat := List.replicate n 0
+
+@[noinline] def g (n : Nat) : Bool :=
+  let r := mk "" n
+  (match r with | [] => "ab" | _ :: _ => "").endsWith (("".drop 6).toString.toLower)
+
+@[noinline] def mkN (_s : Nat) (n : Nat) : List Nat := List.replicate n 0
+
+@[noinline] def h (n : Nat) : Nat :=
+  let r := mkN 100000000000000000000000 n
+  (match r with | [] => 7 | _ :: _ => 100000000000000000000000) + (100000000000000000000000 + n)
+
+def main : IO Unit := do
+  IO.println (g 0)
+  IO.println (g 1)
+  IO.println (h 0)
+  IO.println (h 1)
