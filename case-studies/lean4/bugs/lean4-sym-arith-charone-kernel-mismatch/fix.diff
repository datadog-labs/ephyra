diff --git a/tests/elab/grindSymCharOneEq.lean b/tests/elab/grindSymCharOneEq.lean
new file mode 100644
index 0000000..551e0df
--- /dev/null
+++ b/tests/elab/grindSymCharOneEq.lean
@@ -0,0 +1,14 @@
+/-!
+`grind` with the `Sym.simp`-based normalizer in a ring of characteristic `1`: the sides of
+`0 = x ^ 2` have different polynomials (`Expr.toPolyC` keeps `x ^ 2` with coefficient `1`)
+although their difference is `0`, so the proof must not state both sides as one polynomial.
+-/
+
+example (x : Fin 1) (h : ¬ (0 : Fin 1) = x ^ 2) : False := by
+  set_option backward.grind.normalizer false in grind (maxChar := 2)
+
+example (x : BitVec 0) (h : ¬ (0 : BitVec 0) = x ^ 2) : False := by
+  set_option backward.grind.normalizer false in grind (maxChar := 2)
+
+example (x : BitVec 0) (h : (0 : BitVec 0) = x ^ 2 → False) : False := by
+  set_option backward.grind.normalizer false in grind +distrib (maxChar := 1000000)
