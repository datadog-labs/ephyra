+
+/-! `B` "at night" covers both 21:00–24:00 (PM) and 00:00–06:00 (AM). -/
+
+/-- info: "2024-01-01T22:00:00Z" -/
+#guard_msgs in #eval check "uuuu-MM-dd hh:mm B" "2024-01-01 10:00 at night"
+
+/-- info: "2024-01-01T03:00:00Z" -/
+#guard_msgs in #eval check "uuuu-MM-dd hh:mm B" "2024-01-01 03:00 at night"
+
+def periodDates : List DateTime :=
+  ["00:00:00", "00:00:01", "03:15:00", "05:59:59", "06:00:00", "11:59:59", "12:00:00", "12:00:01",
+   "17:59:59", "18:00:00", "20:59:59", "21:00:00", "22:30:00", "23:59:59"].map fun t =>
+    iso.parse! s!"2024-01-01T{t}Z"
+
+/-- info: [] -/
+#guard_msgs in
+#eval Id.run do
+  let mut failures := #[]
+  for pat in ["uuuu-MM-dd hh:mm:ss B", "uuuu-MM-dd h:mm:ss BBBB", "uuuu-MM-dd KK:mm:ss BBBBB"] do
+    for d in periodDates do
+      unless exact pat d do
+        failures := failures.push (pat, iso.format d)
+  return failures.toList
