+/--
+Infer an `HourMarker` from an `ExtendedDayPeriod` parsed by `B`. `night` spans both 21:00–24:00 and
+00:00–06:00, so it is resolved by the hour of the 12-hour clock (`hour12`, 0–11): 9–11 at night are PM.
+-/
+private def markerOfExtendedDayPeriod (hour12 : Option Int) : ExtendedDayPeriod → HourMarker
+  | .midnight | .morning => .am
+  | .night => if hour12.any (· ≥ 6) then .pm else .am
   | .noon | .afternoon | .evening => .pm
 
