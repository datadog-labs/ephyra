+#[test]
+fn test_reference_keeps_operand_order() {
+    let scene = TestScenario::new(util_name!());
+    let at = &scene.fixtures;
+    at.touch("ref");
+    at.touch("a");
+    at.touch("b");
+    set_permissions(at.plus("ref"), Permissions::from_mode(0o644)).unwrap();
+    set_permissions(at.plus("a"), Permissions::from_mode(0o600)).unwrap();
+    set_permissions(at.plus("b"), Permissions::from_mode(0o600)).unwrap();
+    scene
+        .ucmd()
+        .arg("-c")
+        .arg("--reference=ref")
+        .arg("a")
+        .arg("b")
+        .succeeds()
+        .stdout_is(
+            "mode of 'a' changed from 0600 (rw-------) to 0644 (rw-r--r--)\n\
+             mode of 'b' changed from 0600 (rw-------) to 0644 (rw-r--r--)\n",
+        );
+}
