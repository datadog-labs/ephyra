+
+#[test]
+fn test_negative_offset_regex_after_line_number_does_not_hang() {
+    let (at, mut ucmd) = at_and_ucmd!();
+    ucmd.args(&["-", "/1/", "1", "/x/-1"])
+        .pipe_in("1\n")
+        .fails_with_code(1);
+    assert!(!at.file_exists("xx00"));
+
+    let (at, mut ucmd) = at_and_ucmd!();
+    ucmd.args(&["-", "/3/-1", "2", "/x/-1"])
+        .pipe_in("1\n2\n3\n4\n5\n")
+        .fails()
+        .stdout_is("2\n0\n8\n")
+        .stderr_is("csplit: '/x/-1': match not found\n");
+    assert!(!at.file_exists("xx00"));
+
+    let (at, mut ucmd) = at_and_ucmd!();
+    ucmd.args(&["-", "/3/-2", "2", "/4/-1"])
+        .pipe_in("1\n2\n3\n4\n5\n")
+        .succeeds()
+        .stdout_only("0\n2\n2\n6\n");
+    assert_eq!(at.read("xx00"), "");
+    assert_eq!(at.read("xx01"), "1\n");
+    assert_eq!(at.read("xx02"), "2\n");
+    assert_eq!(at.read("xx03"), "3\n4\n5\n");
+
+    // the lines an earlier regex already examined are not searched again
+    let (at, mut ucmd) = at_and_ucmd!();
+    ucmd.args(&["-", "/3/-2", "2", "/3/-2", "-k"])
+        .pipe_in("1\n2\n3\n4\n5\n")
+        .fails()
+        .stdout_is("0\n2\n8\n")
+        .stderr_is("csplit: '/3/-2': match not found\n");
+    assert_eq!(at.read("xx02"), "2\n3\n4\n5\n");
+}
