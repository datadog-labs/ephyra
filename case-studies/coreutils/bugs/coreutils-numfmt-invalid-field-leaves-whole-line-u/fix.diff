+#[test]
+fn test_invalid_field_does_not_stop_conversion_of_others() {
+    new_ucmd!()
+        .args(&["--invalid=warn", "--field=-", "--to=si"])
+        .pipe_in("x 1000 y 2000\n")
+        .succeeds()
+        .stdout_is("x 1.0k y 2.0k\n")
+        .stderr_is("numfmt: invalid number: 'x'\nnumfmt: invalid number: 'y'\n");
+    new_ucmd!()
+        .args(&["--invalid=ignore", "--field=-", "--to=si", "-d:"])
+        .pipe_in("1000:x:2000\n")
+        .succeeds()
+        .stdout_only("1.0k:x:2.0k\n");
+}
+
+#[test]
+fn test_invalid_field_zero_terminated_newline_becomes_space() {
+    new_ucmd!()
+        .args(&["-z", "--invalid=ignore"])
+        .pipe_in("e\n")
+        .succeeds()
+        .stdout_only("e ");
+    new_ucmd!()
+        .args(&["-z", "--invalid=ignore", "--field=2"])
+        .pipe_in("5\nx\0")
+        .succeeds()
+        .stdout_only("5 x\0");
+}
+
+#[test]
