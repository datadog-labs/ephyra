+/// Convert one selected field, or, unless `--invalid=abort`, hand back `None`
+/// after keeping its error in `invalid`: such a field is written as it came and
+/// the rest of the line is still converted.
+fn convert_field(
+    convert: impl FnOnce() -> Result<String>,
+    options: &NumfmtOptions,
+    invalid: &mut Vec<String>,
+) -> std::result::Result<Option<String>, WriteError> {
+    match convert() {
+        Ok(formatted) => Ok(Some(formatted)),
+        Err(message) if matches!(options.invalid, InvalidModes::Abort) => Err(message.into()),
+        Err(message) => {
+            invalid.push(message);
+            Ok(None)
+        }
+    }
+}
