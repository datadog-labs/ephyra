+        .arg("--tabs=2,/2")
+        .pipe_in("a\tb\tc\td")
+        .succeeds()
+        .stdout_is("a b c d");
+    new_ucmd!()
+        .arg("--tabs=4,+2")
+        .pipe_in("\ta\tb\tc")
+        .succeeds()
+        .stdout_is("    a b c");
