+#[test]
+fn test_section_continues_across_files() {
+    let (at, mut ucmd) = at_and_ucmd!();
+
+    at.write("a.txt", "a\n\\:\n");
+    at.write("b.txt", "b\n\\:\\:\nc");
+
+    ucmd.args(&["a.txt", "b.txt"])
+        .succeeds()
+        .stdout_is("     1\ta\n\n       b\n\n     1\tc\n");
+}
+
