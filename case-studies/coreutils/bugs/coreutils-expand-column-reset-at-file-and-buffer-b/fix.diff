+#[test]
+fn test_column_continues_across_files() {
+    let (at, mut ucmd) = at_and_ucmd!();
+    at.write("f1", "a");
+    at.write("f2", "\tb\n");
+    ucmd.args(&["f1", "f2"]).succeeds().stdout_is("a       b\n");
+}
+
+#[test]
+fn test_initial_continues_across_files() {
+    let (at, mut ucmd) = at_and_ucmd!();
+    at.write("f1", "    ");
+    at.write("f2", "\tx\n");
+    ucmd.args(&["-i", "f1", "f2"])
+        .succeeds()
+        .stdout_is("        x\n");
+}
+
+#[test]
+fn test_column_tracked_across_buffers_without_tabs() {
+    // The first read buffer holds no tab and no newline.
+    let input = format!("{}bcd\tx\n", "a".repeat(8190));
+    let expected = format!("{}bcd   x\n", "a".repeat(8190));
+    new_ucmd!()
+        .arg("-t3")
+        .pipe_in(input)
+        .succeeds()
+        .stdout_is(expected);
+}
