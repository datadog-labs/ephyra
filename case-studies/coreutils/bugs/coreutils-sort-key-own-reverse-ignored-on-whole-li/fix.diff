+#[test]
+fn test_whole_line_key_with_its_own_reverse() {
+    // The key spans the whole line but has its own `r`, which overrides the
+    // global ordering for that key.
+    for args in [&["-k1r"][..], &["-k1.1r"], &["-f", "-k1fr"]] {
+        new_ucmd!()
+            .args(args)
+            .pipe_in("a\n\nb\n")
+            .succeeds()
+            .stdout_is("b\na\n\n");
+    }
+}
