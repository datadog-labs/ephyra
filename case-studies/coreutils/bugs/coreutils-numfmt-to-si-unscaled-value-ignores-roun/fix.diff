+#[test]
+fn test_round_to_si_below_first_suffix() {
+    for (method, exp) in [
+        ("from-zero", ["13", "-13", "13", "-999", "1.0k", "-1.0k"]),
+        ("towards-zero", ["12", "-12", "12", "-998", "999", "-999"]),
+        ("up", ["13", "-12", "13", "-998", "1.0k", "-999"]),
+        ("down", ["12", "-13", "12", "-999", "999", "-1.0k"]),
+        ("nearest", ["12", "-12", "13", "-999", "999", "-999"]),
+    ] {
+        new_ucmd!()
+            .args(&[
+                "--to=si",
+                &format!("--round={method}"),
+                "--",
+                "12.1",
+                "-12.1",
+                "12.5",
+                "-998.5",
+                "999.4",
+                "-999.4",
+            ])
+            .succeeds()
+            .stdout_only(exp.join("\n") + "\n");
+    }
+}
+
+#[test]
+fn test_round_to_si_stays_unscaled_with_format_precision() {
+    new_ucmd!()
+        .args(&["--to=si", "--round=down", "--format=%.1f", "999.9"])
+        .succeeds()
+        .stdout_only("999.0\n");
+}
