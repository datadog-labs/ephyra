+
+#[test]
+fn test_line_continues_into_next_file() {
+    // The files form one stream, like `cat f1 f2 | unexpand`
+    let (at, mut ucmd) = at_and_ucmd!();
+    at.write("f1", "a");
+    at.write("f2", " \t");
+    ucmd.args(&["f1", "f2"]).succeeds().stdout_is("a \t");
+    let (at, mut ucmd) = at_and_ucmd!();
+    at.write("f1", "    ");
+    at.write("f2", "    x\n");
+    ucmd.args(&["f1", "f2"]).succeeds().stdout_is("\tx\n");
+}
