+
+#[test]
+fn test_skip_fields_only_blanks_separate_fields() {
+    // '\r' and '\f' are not blanks, so "a\rb" is a single field
+    new_ucmd!()
+        .args(&["-f", "1"])
+        .pipe_in("a\rb\nc\rd\n")
+        .succeeds()
+        .stdout_is("a\rb\n");
+    new_ucmd!()
+        .args(&["-f", "1"])
+        .pipe_in("a\x0cb\nc\x0cd\n")
+        .succeeds()
+        .stdout_is("a\x0cb\n");
+    new_ucmd!()
+        .args(&["-z", "-f", "1"])
+        .pipe_in("a\nb\0c\nd\0")
+        .succeeds()
+        .stdout_is("a\nb\0c\nd\0");
+}
