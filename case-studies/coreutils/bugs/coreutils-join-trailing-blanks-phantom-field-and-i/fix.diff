+#[test]
+fn test_trailing_blanks_add_no_field() {
+    let scene = TestScenario::new(util_name!());
+    let at = &scene.fixtures;
+    at.write("a", "1 2 \t\n");
+    at.write("b", "1\n");
+    scene
+        .ucmd()
+        .args(&["a", "b"])
+        .succeeds()
+        .stdout_only("1 2\n");
+    scene
+        .ucmd()
+        .args(&["-o", "auto", "-e", "X", "a", "b"])
+        .succeeds()
+        .stdout_only("1 2\n");
+    // With -z, a newline is a blank too.
+    at.write("az", "1\n");
+    at.write("bz", "1");
+    scene
+        .ucmd()
+        .args(&["-z", "az", "bz"])
+        .succeeds()
+        .stdout_only("1\0");
+}
+
+#[test]
+fn test_ignore_case_uses_each_lines_own_key() {
+    let scene = TestScenario::new(util_name!());
+    let at = &scene.fixtures;
+    at.write("a", "B x\nb y\n");
+    at.write("b", "b z\n");
+    scene
+        .ucmd()
+        .args(&["-i", "a", "b"])
+        .succeeds()
+        .stdout_only("B x z\nb y z\n");
+    scene
+        .ucmd()
+        .args(&["-i", "-o", "0", "a", "b"])
+        .succeeds()
+        .stdout_only("B\nb\n");
+}
