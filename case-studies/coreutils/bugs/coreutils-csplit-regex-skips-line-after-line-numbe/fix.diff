+#[test]
+fn test_up_to_match_searches_line_after_line_number() {
+    // the line a line-number pattern stops at is the first one the next regex looks at
+    new_ucmd!()
+        .args(&["-", "2", "/[0-9]/"])
+        .pipe_in("a\n1\n2\n")
+        .succeeds()
+        .stdout_only("2\n0\n4\n");
+    new_ucmd!()
+        .args(&["-", "3", "/3/"])
+        .pipe_in("1\n2\n3\n4\n")
+        .succeeds()
+        .stdout_only("4\n0\n4\n");
+}
+
+#[test]
+fn test_up_to_match_starts_after_offset_split_line() {
+    // with a positive offset the line the split stops at was read, so it is not searched again
+    new_ucmd!()
+        .args(&["-", "/2/+1", "/[0-9]/"])
+        .pipe_in("1\n2\n3\n4\n5\n6\n")
+        .succeeds()
+        .stdout_only("4\n2\n6\n");
+    new_ucmd!()
+        .args(&["-", "/5/+1", "/[0-9]/"])
+        .pipe_in("1\n2\n3\n4\n5\n6\n")
+        .fails_with_code(1)
+        .stdout_is("10\n2\n")
+        .stderr_is("csplit: '/[0-9]/': match not found\n");
+}
+
+#[test]
+fn test_suppress_matched_line_number_already_passed() {
+    // the empty split still starts at a boundary line, which is suppressed
+    new_ucmd!()
+        .args(&["--suppress-matched", "-", "/2/+2", "3"])
+        .pipe_in("1\n2\n3\n4\n5\n6\n")
+        .succeeds()
+        .stdout_only("6\n0\n2\n");
+}
