+    /// Move the buffered lines that no regex looked at yet out of the buffer, so that the next
+    /// calls to [`Self::next_examined`] return them first.
+    fn queue_unexamined(&mut self) {
+        self.rewind = false;
+        let first = self
+            .buffer
+            .iter()
+            .position(|(ln, _)| *ln >= self.examined)
+            .unwrap_or(self.buffer.len());
+        self.unexamined = self.buffer.split_off(first);
+    }
+
+    /// Return the next line to be searched by a regex and record that it was looked at.
+    fn next_examined(&mut self) -> Option<<I as Iterator>::Item> {
+        let item = if self.unexamined.is_empty() {
+            self.next()
+        } else {
+            Some(self.unexamined.remove(0))
+        };
+        if let Some((ln, _)) = &item {
+            self.examined = self.examined.max(ln + 1);
         }
+        item
     }
 
