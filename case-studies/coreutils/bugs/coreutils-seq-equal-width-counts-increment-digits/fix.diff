+#[test]
+fn test_equalize_widths_ignores_increment_width() {
+    new_ucmd!()
+        .args(&["-w", "1", "-1", "1"])
+        .succeeds()
+        .stdout_is("1\n");
+    new_ucmd!()
+        .args(&["-w", "5", "-1", "3"])
+        .succeeds()
+        .stdout_is("5\n4\n3\n");
+    new_ucmd!()
+        .args(&["-w", "1", "007", "8"])
+        .succeeds()
+        .stdout_is("1\n8\n");
+    new_ucmd!()
+        .args(&["-w", "10", "-1", "8"])
+        .succeeds()
+        .stdout_is("10\n09\n08\n");
+}
