diff --git a/tests/by-util/test_split.rs b/tests/by-util/test_split.rs
index 29a6a7dad..1751cc9d3 100644
--- a/tests/by-util/test_split.rs
+++ b/tests/by-util/test_split.rs
@@ -2336,3 +2336,21 @@ fn test_obsolete_lines_not_read_after_double_dash() {
         .fails()
         .stderr_contains("cannot open '-1' for reading");
 }
+
+#[test]
+fn test_numeric_suffix_start_too_large_on_empty_input() {
+    for args in [
+        &["--numeric-suffixes=100"][..],
+        &["-a", "1", "--hex-suffixes=15"],
+    ] {
+        new_ucmd!()
+            .args(args)
+            .pipe_in("")
+            .fails_with_code(1)
+            .stderr_contains("numerical suffix start value is too large for the suffix length");
+    }
+    new_ucmd!()
+        .args(&["-a", "1", "--hex-suffixes=f"])
+        .pipe_in("")
+        .succeeds();
+}
