+/// `-a 0` is the same as if `-a` was not specified, also with `-n`
+#[test]
+fn test_suffix_length_zero_with_number() {
+    let (at, mut ucmd) = at_and_ucmd!();
+    ucmd.args(&["-n", "2", "-a", "0", "fivelines.txt"])
+        .succeeds()
+        .no_output();
+    assert!(at.file_exists("xaa"));
+    assert!(at.file_exists("xab"));
+    assert!(!at.file_exists("xa"));
+}
