+#[test]
+fn test_negative_value_rounded_to_zero() {
+    new_ucmd!()
+        .args(&["--to-unit=1000", "--round=nearest", "--", "-3"])
+        .succeeds()
+        .stdout_only("0\n");
+    new_ucmd!()
+        .args(&["--round=towards-zero", "--format=%.2f", "--", "-0.003"])
+        .succeeds()
+        .stdout_only("0.00\n");
+    new_ucmd!()
+        .args(&["--round=up", "--format=%05.0f", "--", "-0.3"])
+        .succeeds()
+        .stdout_only("00000\n");
+    new_ucmd!()
+        .args(&["--to=si", "--round=nearest", "--format=%.0f", "--", "-0.3"])
+        .succeeds()
+        .stdout_only("0\n");
+}
