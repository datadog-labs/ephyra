+#[test]
+fn test_line_number_suppress_matched_just_past_end() {
+    // like GNU, the suppressed line may be the one just past the end of the input
+    let (at, mut ucmd) = at_and_ucmd!();
+    ucmd.args(&["--suppress-matched", "-", "3"])
+        .pipe_in("1\n2\n")
+        .succeeds()
+        .stdout_only("4\n0\n");
+    assert_eq!(at.read("xx00"), "1\n2\n");
+    assert_eq!(at.read("xx01"), "");
+
+    new_ucmd!()
+        .args(&["--suppress-matched", "-", "4"])
+        .pipe_in("1\n2\n")
+        .fails_with_code(1)
+        .stderr_contains("csplit: '4': line number out of range");
+
+    new_ucmd!()
+        .args(&["--suppress-matched", "-", "2", "3"])
+        .pipe_in("1\n2\n")
+        .fails_with_code(1)
+        .stderr_contains("csplit: '3': line number out of range");
+}
