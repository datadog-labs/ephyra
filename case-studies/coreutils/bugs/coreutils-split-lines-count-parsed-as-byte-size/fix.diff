+/// Parse a number of lines: a plain decimal count, without the size
+/// suffixes or base prefixes that `-b` and `-C` accept. Values too large
+/// for a `u64` saturate, as for the other sizes.
+fn parse_lines(s: &str) -> Result<u64, ParseSizeError> {
+    if s.is_empty() || !s.bytes().all(|b| b.is_ascii_digit()) {
+        return Err(ParseSizeError::ParseFailure(s.quote().to_string()));
+    }
+    Ok(s.parse().unwrap_or(u64::MAX))
+}
