+    let (at, mut ucmd) = at_and_ucmd!();
+    at.write("input1", "a");
+    at.write("input2", "\n\nb\n");
+    ucmd.args(&["-s", "input1", "input2"])
+        .succeeds()
+        .stdout_only("a\n\nb\n");
+}
