diff --git a/backend/amd64/emit.ml b/backend/amd64/emit.ml
index 2c90905eda..87edb387b1 100644
--- a/backend/amd64/emit.ml
+++ b/backend/amd64/emit.ml
@@ -1736,6 +1736,25 @@ let emit_atomic instr (op : Cmm.atomic_op) (size : Cmm.atomic_bitwidth) addr =
     assert (Reg.is_reg instr.arg.(0));
     I.xchg src dst
 
+(* We have i.arg.(0) = i.res.(0) and i.arg.(1) = i.res.(1). When x0 and y1
+   hold the same value, the register allocator may also assign i.arg.(3) to
+   i.res.(0), so i.arg.(3) must be read before i.res.(0) is written. *)
+let emit_int128_addsub i ~lo ~hi =
+  if not (Reg.same_loc i.arg.(3) i.res.(0))
+  then (
+    lo (arg i 2) (res i 0);
+    hi (arg i 3) (res i 1))
+  else if not (Reg.same_loc i.arg.(2) i.res.(1))
+  then (
+    lo (arg i 3) (res i 1);
+    lo (arg i 2) (res i 0);
+    hi (int 0) (res i 1))
+  else (
+    (* x0 = y1 and x1 = y0: the high half is 0 +/- the low half +/- carry *)
+    lo (arg i 2) (res i 0);
+    I.mov (int 0) (res i 1);
+    hi (res i 0) (res i 1))
+
 let emit_reinterpret_cast (cast : Cmm.reinterpret_cast) i =
   let open Simd_instrs in
   let distinct = not (Reg.same_loc i.arg.(0) i.res.(0)) in
@@ -2475,12 +2494,8 @@ let emit_instr ~first ~last ~fallthrough i =
   | Lop (Intop (Idiv { signed = false } | Imod { signed = false })) ->
     I.xor (Reg32 RDX) (Reg32 RDX);
     I.div (arg i 1)
-  | Lop (Int128op Iadd128) ->
-    I.add (arg i 2) (res i 0);
-    I.adc (arg i 3) (res i 1)
-  | Lop (Int128op Isub128) ->
-    I.sub (arg i 2) (res i 0);
-    I.sbb (arg i 3) (res i 1)
+  | Lop (Int128op Iadd128) -> emit_int128_addsub i ~lo:I.add ~hi:I.adc
+  | Lop (Int128op Isub128) -> emit_int128_addsub i ~lo:I.sub ~hi:I.sbb
   | Lop (Int128op (Imul64 { signed = true })) -> I.imul (arg i 1) None
   | Lop (Int128op (Imul64 { signed = false })) -> I.mul (arg i 1)
   | Lop (Intop ((Ilsl | Ilsr | Iasr) as op)) ->
diff --git a/oxcaml/tests/simd/int128.ml b/oxcaml/tests/simd/int128.ml
index 3e5e7f0bc7..100fad32ce 100644
--- a/oxcaml/tests/simd/int128.ml
+++ b/oxcaml/tests/simd/int128.ml
@@ -117,3 +117,33 @@ let () = (* (1<<64-1) * 2 *)
   let #(z0,z1) = unsigned_mul_int64 (-#1L) #2L in
   eq z0 I64.(shift_left (-#1L) 1);
   eq z1 #1L
+
+(* The low half of the first argument and the high half of the second argument
+   hold the same value (and likewise the other two halves). *)
+let () =
+  let a = Sys.opaque_identity 0x4394L in
+  let b = Sys.opaque_identity 0x1000000L in
+  let #(z0,z1) =
+    sub_int128 ~x0:(I64.of_int64 a) ~x1:(I64.of_int64 b) ~y0:#0x2004L
+      ~y1:(I64.of_int64 a)
+  in
+  eq z0 #0x2390L;
+  eq z1 #0xffbc6cL;
+  let #(z0,z1) =
+    add_int128 ~x0:(I64.of_int64 a) ~x1:(I64.of_int64 b) ~y0:#0x2004L
+      ~y1:(I64.of_int64 a)
+  in
+  eq z0 #0x6398L;
+  eq z1 #0x1004394L;
+  let #(z0,z1) =
+    sub_int128 ~x0:(I64.of_int64 a) ~x1:(I64.of_int64 b)
+      ~y0:(I64.of_int64 b) ~y1:(I64.of_int64 a)
+  in
+  eq z0 (-#0xffbc6cL);
+  eq z1 #0xffbc6bL;
+  let #(z0,z1) =
+    add_int128 ~x0:(I64.of_int64 a) ~x1:(I64.of_int64 b)
+      ~y0:(I64.of_int64 b) ~y1:(I64.of_int64 a)
+  in
+  eq z0 #0x1004394L;
+  eq z1 #0x1004394L
