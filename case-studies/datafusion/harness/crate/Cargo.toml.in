[package]
name = "dfz"
version = "0.0.0"
edition = "2024"
publish = false

[dependencies]
datafusion = { path = "@SRC@/datafusion/core", default-features = false, features = [
    "nested_expressions", "crypto_expressions", "datetime_expressions", "encoding_expressions",
    "regex_expressions", "string_expressions", "unicode_expressions", "recursive_protection", "sql",
] }
ephyra = { path = "@EPHYRA@/crates/ephyra", default-features = false }
tokio = { version = "1", features = ["rt-multi-thread"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"

[workspace]

# like the target's ci-optimized profile (release + debug assertions) but
# without LTO so mutant rebuilds are quicker
[profile.fuzz]
inherits = "release"
debug-assertions = true
codegen-units = 16
lto = false
incremental = false
debug = "line-tables-only"
