diff --git a/testsuite/tests/basic/switch_fail_interval.ml b/testsuite/tests/basic/switch_fail_interval.ml
new file mode 100644
index 000000000..124baa3bf
--- /dev/null
+++ b/testsuite/tests/basic/switch_fail_interval.ml
@@ -0,0 +1,21 @@
+(* TEST
+ flags = "-w -8-11";
+*)
+
+(* When the largest constant of an integer switch leads to the failure
+   action, the failure interval must extend to the upper bound of the
+   switch; values above that constant must raise Match_failure instead of
+   jumping out of the switch table. *)
+
+let f x y = match x, y with
+  | _, true -> 0
+  | (0 | 3), _ -> 1
+  | 4, true -> 2
+  | -2, _ -> 4
+
+let test x =
+  match f (Sys.opaque_identity x) false with
+  | r -> Printf.printf "%d -> %d\n" x r
+  | exception Match_failure _ -> Printf.printf "%d -> Match_failure\n" x
+
+let () = List.iter test [min_int; -3; -2; -1; 0; 3; 4; 5; 256; max_int]
