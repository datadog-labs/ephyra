From 845e09c7d0e5f37ab203ae0797b57d4fd70cfa68 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Alperen=20Kele=C5=9F?= <alpkeles99@gmail.com>
Date: Wed, 21 Oct 2026 17:38:22 -0400
Subject: [PATCH] Fix missing upper-bound test in switches whose last key fails

In as_interval_canfail, when the sorted keys end with keys whose action
is the failure action, fail_rec closed the last interval at the last
key instead of at [high]. The case array then no longer covered
[low, high], and Switch omitted the upper-bound test, so a value above
the last key indexed past the switch table (wild jump in bytecode,
segfault in native code) instead of raising Match_failure.

End the final failure interval at [high], as nofail_rec already does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lambda/matching.ml                            | 12 +++++------
 testsuite/tests/basic/switch_fail_interval.ml | 21 +++++++++++++++++++
 .../basic/switch_fail_interval.reference      | 10 +++++++++
 3 files changed, 37 insertions(+), 6 deletions(-)
 create mode 100644 testsuite/tests/basic/switch_fail_interval.ml
 create mode 100644 testsuite/tests/basic/switch_fail_interval.reference

diff --git a/lambda/matching.ml b/lambda/matching.ml
index 1bc0493..7697633 100644
--- a/lambda/matching.ml
+++ b/lambda/matching.ml
@@ -2843,22 +2843,22 @@ let as_interval_canfail fail ~low ~high l =
           if act_index = cur_act then
             nofail_rec cur_low i cur_act rem
           else if act_index = 0 then
-            (cur_low, i - 1, cur_act) :: fail_rec i i rem
+            (cur_low, i - 1, cur_act) :: fail_rec i rem
           else
             (cur_low, i - 1, cur_act) :: nofail_rec i i act_index rem
         else if act_index = 0 then
           (cur_low, cur_high, cur_act)
-          :: fail_rec (cur_high + 1) (cur_high + 1) all
+          :: fail_rec (cur_high + 1) all
         else
           (cur_low, cur_high, cur_act)
           :: (cur_high + 1, i - 1, 0)
           :: nofail_rec i i act_index rem
-  and fail_rec cur_low cur_high = function
-    | [] -> [ (cur_low, cur_high, 0) ]
+  and fail_rec cur_low = function
+    | [] -> [ (cur_low, high, 0) ]
     | (i, act_i) :: rem ->
         let index = do_store "YES" act_i in
         if index = 0 then
-          fail_rec cur_low i rem
+          fail_rec cur_low rem
         else
           (cur_low, i - 1, 0) :: nofail_rec i i index rem
   in
@@ -2867,7 +2867,7 @@ let as_interval_canfail fail ~low ~high l =
     | (i, act_i) :: rem ->
         let index = do_store "INIT" act_i in
         if index = 0 then
-          fail_rec low i rem
+          fail_rec low rem
         else if low < i then
           (low, i - 1, 0) :: nofail_rec i i index rem
         else
diff --git a/testsuite/tests/basic/switch_fail_interval.ml b/testsuite/tests/basic/switch_fail_interval.ml
new file mode 100644
index 0000000..a702f39
--- /dev/null
+++ b/testsuite/tests/basic/switch_fail_interval.ml
@@ -0,0 +1,21 @@
+(* TEST
+ flags = "-w -8-11";
+*)
+
+(* When the largest constant of an integer switch leads to the failure
+   action, the failure interval must extend to the upper bound of the
+   switch; values above that constant must raise Match_failure instead of
+   jumping out of the switch table. *)
+
+let f x y = match x, y with
+  | _, true -> 0
+  | (0 | 3), _ -> 1
+  | 4, true -> 2
+  | -2, _ -> 4
+
+let test x =
+  match f x false with
+  | r -> Printf.printf "%d -> %d\n" x r
+  | exception Match_failure _ -> Printf.printf "%d -> Match_failure\n" x
+
+let () = List.iter test [min_int; -3; -2; -1; 0; 3; 4; 5; 256; max_int]
diff --git a/testsuite/tests/basic/switch_fail_interval.reference b/testsuite/tests/basic/switch_fail_interval.reference
new file mode 100644
index 0000000..43038d2
--- /dev/null
+++ b/testsuite/tests/basic/switch_fail_interval.reference
@@ -0,0 +1,10 @@
+-4611686018427387904 -> Match_failure
+-3 -> Match_failure
+-2 -> 4
+-1 -> Match_failure
+0 -> 1
+3 -> 1
+4 -> Match_failure
+5 -> Match_failure
+256 -> Match_failure
+4611686018427387903 -> Match_failure
-- 
