# Backport of upstream trunk commit 60c029277 "switch: fix overflow on min_int"
# (ocaml/ocaml #14890, Changes: "fix pattern compilation in presence of the
# [min_int] constant pattern"), not in 5.4.0/5.4.1. Without it 5.4.0 compiles
# `match x with -4611686018427387904 -> a | (2|4) when false -> b | _ -> c`
# to an offset switch whose bound check overflows, returning a for x = 0.
diff --git a/lambda/switch.ml b/lambda/switch.ml
index 73e8f144a..01c717225 100644
--- a/lambda/switch.ml
+++ b/lambda/switch.ml
@@ -958,7 +958,10 @@ let rec pkey chan  = function
 
   let do_zyva loc (low,high) arg cases actions =
     let old_ok = !ok_inter in
-    ok_inter := (abs low <= inter_limit && abs high <= inter_limit) ;
+    ok_inter :=
+      (* both [inter_limit] and [high] are strictly greater than [min_int] *)
+      (low >= -inter_limit && low <= inter_limit
+      && abs high <= inter_limit) ;
     if !ok_inter <> old_ok then Hashtbl.clear t ;
 
     let s = {cases=cases ; actions=actions} in
