# Settings for start-run.sh, watchdog.sh, refresh-trunk.sh and
# build-fixed.sh. Copy to runner.env (or point RUNNER_ENV at another file)
# and adjust.

# Where run directories live; RUN_ROOT/current is the run in progress.
RUN_ROOT="$HOME/fuzz-runs"

# Workers by loop profile (src/bin/runner/profiles.rs), assigned in order;
# the generator is the same for all. gen: fresh draws (the bug-finding
# throughput); gen-deep: 300-1000 queries under every oracle; rare: mutants
# of inputs reaching counters rare in the reference; novel: mutants of
# inputs that reached new counters; near-miss: mutants of inputs whose
# oracles skipped comparisons. NAME+wal: the same loop with the database in
# a WAL file in SQLITE_TMPDIR (below), not in memory, and the storage oracle
# (memory against the WAL file) in its rotation. havoc and splice (stacked
# mutations, splices of three seeds) are still selectable, but out of the
# default since 2026-10-11: every profile reached at least 99.8% of the
# union's coverage, so known-bug rediscoveries per profile are the
# scoreboard. 15 workers.
PROFILES="gen:5,gen-deep:2,rare:2,novel:3,near-miss:1,gen+wal:1,novel+wal:1"

# Used only when PROFILES is empty: fresh (gen) and targeted (rare) workers.
FRESH=12
TARGETED=2

# How long a run lasts (hours); the nightly trunk refresh starts a new run
# sooner when trunk moves.
HOURS=168

# Draws in the rare workers' reference.
REFERENCE=30000

# Queries per database: k drawn log-uniformly from this range for each
# fresh input (one database serves many queries, which cost less each the
# more share it; gen-deep has its own range). Empty for the generator's own
# 1 to 6.
QUERIES="1-300"

# Identity carried by every record and metric.
CAMPAIGN="sqlite/campaign/runner"
TAG="sqlite/campaign/runner"

# DogStatsD (a Datadog agent or any DogStatsD listener, see README.md);
# empty for none.
STATSD="127.0.0.1:8125"
TAGS="env:fuzz"

# Per-worker memory limit (MB) and heartbeat limit (seconds).
MAX_RSS_MB=8192
STALE_SECS=300

# Where SQLite puts its temporary files (sorts, DISTINCT, materialized CTEs
# spill to them even for in-memory databases), and where the +wal workers
# keep their database files (ephyra-wal-<run>-w<id>/; /tmp when this is
# empty): a tmpfs, so that they cost no disk writes. SQLite would otherwise
# pick /var/tmp, usually on disk, where 15 workers write about 100 MB/s.
# On the original host /tmp was a tmpfs with 31 GB free; /dev/shm was only
# 64 MB (a container's default), too small for WAL files. Empty for
# SQLite's own choice.
SQLITE_TMPDIR="/tmp"

# What new runs test: master (plain trunk, the default) or fixed (trunk with
# every open known bug's fix applied, build-fixed.sh's, vendored by
# refresh-trunk.sh on each new trunk; plain trunk when that build fails),
# so that runs stop rediscovering known bugs. Pre-triage still replays on
# plain trunk and each bug's CLI, plus the fixed CLI (verdict fixes-only).
# A change takes effect at the next trunk move, or FORCE=1 refresh-trunk.sh.
SQLITE_TARGET=master
