 /*
+** Walker callback for exprHasFixedCol().
+*/
+static int exprNodeIsFixedCol(Walker *pWalker, Expr *pExpr){
+  if( pExpr->op==TK_COLUMN && ExprHasProperty(pExpr, EP_FixedCol) ){
+    pWalker->eCode = 1;
+    return WRC_Abort;
+  }
+  return WRC_Continue;
+}
+
+/*
+** Return true if pExpr contains a TK_COLUMN node that has been tagged
+** EP_FixedCol by the constant propagation optimization.
+*/
+static int exprHasFixedCol(Expr *pExpr){
+  Walker w;
+  memset(&w, 0, sizeof(w));
+  w.xExprCallback = exprNodeIsFixedCol;
+  sqlite3WalkExpr(&w, pExpr);
+  return w.eCode;
+}
