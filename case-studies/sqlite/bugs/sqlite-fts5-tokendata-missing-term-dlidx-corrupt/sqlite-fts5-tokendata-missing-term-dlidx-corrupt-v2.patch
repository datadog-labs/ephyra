+#-------------------------------------------------------------------------
+# Query a tokendata=1 table for a term that is not present in a segment,
+# where the next larger term in the segment is on a later leaf page than
+# the large doclist (one with a doclist-index) that precedes it.
+#
+reset_db
+do_execsql_test 2.0 {
+  CREATE VIRTUAL TABLE ft USING fts5(a, tokendata=1);
+  INSERT INTO ft(ft, rank) VALUES('pgsz', 64);
+  WITH s(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<100)
+  INSERT INTO ft(rowid, a) SELECT i, iif(i<100, 'u0', 'v') FROM s;
+}
+
+do_execsql_test 2.1 {
+  INSERT INTO ft(ft) VALUES('integrity-check');
+}
+
+do_execsql_test 2.2 {
+  SELECT count(*) FROM ft('u1');
+} {0}
+
+do_execsql_test 2.3 {
+  SELECT count(*), max(rowid) FROM ft('u0');
+} {99 99}
+
+do_execsql_test 2.4 {
+  SELECT rowid FROM ft('v');
+} {100}
+
+do_execsql_test 2.5 {
+  INSERT INTO ft(rowid, a) VALUES(200, 'u1');
+  SELECT rowid FROM ft('u1');
+} {200}
+
+do_execsql_test 2.6 {
+  SELECT rowid FROM ft('u1') ORDER BY rowid DESC;
+} {200}
+
+do_execsql_test 2.7 {
+  SELECT rowid FROM ft('u1') WHERE rowid>150;
+  SELECT count(*) FROM ft('u1') WHERE rowid<150;
+} {200 0}
+
+do_execsql_test 2.8 {
+  SELECT count(*) FROM ft('u*');
+} {100}
+
+do_execsql_test 2.9 {
+  INSERT INTO ft(ft) VALUES('optimize');
+  SELECT rowid FROM ft('u1');
+  SELECT count(*) FROM ft('u2');
+} {200 0}
+
+#-------------------------------------------------------------------------
+# An incremental merge writes the whole of the first term of each step
+# to the %_idx table. So a query for a term that is present in the 
+# segment may also find it on a page after the one %_idx points to. 
+# The doclist of that term has a doclist-index in case 3.2 only.
+#
+foreach {tn nU1 res} {
+  1  1 {2 202 2 {202 201}}
+  2 50 {100 202 13 {202 201 200}}
+} {
+  reset_db
+  sqlite3_fts5_register_origintext db
+  do_execsql_test 3.$tn.0 {
+    CREATE VIRTUAL TABLE ft USING fts5(a, tokendata=1,
+      tokenize="origintext unicode61"
+    );
+    INSERT INTO ft(ft, rank) VALUES('pgsz', 64);
+    INSERT INTO ft(ft, rank) VALUES('usermerge', 2);
+  }
+  foreach s {1 2} {
+    do_execsql_test 3.$tn.1.$s {
+      WITH s(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<100)
+      INSERT INTO ft(rowid, a) 
+        SELECT i*2+$s, iif(i<=100-$nU1, 'u0', 'U1') FROM s;
+    }
+  }
+  do_execsql_test 3.$tn.2 {
+    INSERT INTO ft(ft, rank) VALUES('merge', 1);
+    INSERT INTO ft(ft, rank) VALUES('merge', 1);
+    SELECT quote(term) FROM ft_idx;
+  } {X'' X'307531005531'}
+  do_execsql_test 3.$tn.3 {
+    INSERT INTO ft(ft) VALUES('integrity-check');
+  }
+  do_execsql_test 3.$tn.4 {
+    SELECT count(*), max(rowid) FROM ft('u1');
+    SELECT count(*) FROM ft('u1') WHERE rowid>=190;
+    SELECT group_concat(rowid, ' ') FROM (
+      SELECT rowid FROM ft('u1') ORDER BY rowid DESC LIMIT 3
+    );
+  } $res
+}
+
 finish_test
 
