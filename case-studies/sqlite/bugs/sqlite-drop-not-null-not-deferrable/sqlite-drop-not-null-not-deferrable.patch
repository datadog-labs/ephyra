+    "ALTER TABLE c1 DROP CONSTRAINT c"
+    "CREATE TABLE c1(b REFERENCES p1 DEFERRABLE INITIALLY DEFERRED)"
+
+  9 "CREATE TABLE c1(b REFERENCES p1 CONSTRAINT nn NOT NULL
+       DEFERRABLE INITIALLY DEFERRED)"
