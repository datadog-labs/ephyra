 /*
+** Argument pVal is the right-hand side of a "rowid = ?" constraint. If
+** an integer rowid can be equal to it, set *piRowid to that integer and
+** return 1. Otherwise (NULL, a real that is not an integer, or a text or
+** blob value that is not a number) return 0.
+*/
+static int fts5RowidEqValue(sqlite3_value *pVal, i64 *piRowid){
+  switch( sqlite3_value_numeric_type(pVal) ){
+    case SQLITE_INTEGER:
+      *piRowid = sqlite3_value_int64(pVal);
+      return 1;
+    case SQLITE_FLOAT: {
+      double r = sqlite3_value_double(pVal);
+      if( r>=-9223372036854775808.0 && r<9223372036854775808.0 ){
+        i64 iVal = (i64)r;
+        if( (double)iVal==r ){
+          *piRowid = iVal;
+          return 1;
+        }
+      }
+      break;
+    }
+  }
+  return 0;
+}
