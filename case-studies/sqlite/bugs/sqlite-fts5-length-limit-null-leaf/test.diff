--- a/ext/fts5/test/fts5limits.test
+++ b/ext/fts5/test/fts5limits.test
@@ -43,5 +43,80 @@
   } $res
 }
 
-finish_test
+#-------------------------------------------------------------------------
+# A leaf, the averages record or a docsize blob is longer than
+# SQLITE_LIMIT_LENGTH. Writing it must fail with SQLITE_TOOBIG and leave
+# the table as it was, not store NULL in place of the blob.
+#
+reset_db
+set doc {a b c d e f g h i j k l m n o p q r s t u v w x y z}
+do_execsql_test 2.0 {
+  CREATE VIRTUAL TABLE ft USING fts5(a);
+  INSERT INTO ft VALUES('x y z');
+  CREATE VIRTUAL TABLE ft2 USING fts5(
+    c0,c1,c2,c3,c4,c5,c6,c7,c8,c9,c10,c11,c12,c13,c14,c15,c16,c17,c18,c19,
+    c20,c21,c22,c23,c24,c25,c26,c27,c28,c29,c30, content=''
+  );
+}
+sqlite3_limit db SQLITE_LIMIT_LENGTH 100
+do_catchsql_test 2.1 {
+  INSERT INTO ft VALUES($doc);
+} {1 {string or blob too big}}
+do_test 2.2 { sqlite3_extended_errcode db } SQLITE_TOOBIG
+do_execsql_test 2.3 {
+  BEGIN;
+  INSERT INTO ft VALUES($doc);
+}
+do_catchsql_test 2.4 { COMMIT } {1 {string or blob too big}}
+do_execsql_test 2.5 {
+  BEGIN;
+  INSERT INTO ft VALUES($doc);
+}
+do_catchsql_test 2.6 {
+  INSERT INTO ft SELECT 'q' FROM (VALUES(1),(2));
+} {1 {string or blob too big}}
+do_catchsql_test 2.7 { COMMIT } {1 {string or blob too big}}
+sqlite3_limit db SQLITE_LIMIT_LENGTH 30
+do_catchsql_test 2.8 {
+  INSERT INTO ft2(c0) VALUES('');
+} {1 {string or blob too big}}
+sqlite3_limit db SQLITE_LIMIT_LENGTH 1000000000
+do_execsql_test 2.9 {
+  SELECT count(*) FROM ft_data WHERE block IS NULL;
+  SELECT count(*) FROM ft2_data WHERE block IS NULL;
+  SELECT count(*) FROM ft2_docsize;
+  SELECT rowid, a FROM ft;
+  SELECT rowid FROM ft('x');
+  INSERT INTO ft(ft) VALUES('integrity-check');
+  INSERT INTO ft2(ft2) VALUES('integrity-check');
+  PRAGMA integrity_check;
+} {0 0 0 1 {x y z} 1 ok}
+do_execsql_test 2.10 {
+  INSERT INTO ft VALUES($doc);
+  INSERT INTO ft2(rowid, c0) VALUES(5, 'x');
+  SELECT rowid FROM ft('a');
+  SELECT rowid FROM ft2('x');
+  INSERT INTO ft(ft) VALUES('integrity-check');
+  INSERT INTO ft2(ft2) VALUES('integrity-check');
+  PRAGMA integrity_check;
+} {2 5 ok}
 
+# A query term whose index key (the term plus a prefix byte) is longer than
+# the limit must fail, not match nothing.
+#
+reset_db
+set Z [string repeat z 30]
+do_execsql_test 3.0 {
+  CREATE VIRTUAL TABLE ft USING fts5(a);
+  INSERT INTO ft(ft, rank) VALUES('pgsz', 64);
+  WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM c WHERE i<300)
+  INSERT INTO ft SELECT 'w' || printf('%05d', i) FROM c;
+  INSERT INTO ft VALUES($Z);
+  INSERT INTO ft(ft) VALUES('optimize');
+}
+sqlite3_limit db SQLITE_LIMIT_LENGTH 30
+do_catchsql_test 3.1 { SELECT rowid FROM ft($Z) } {1 {string or blob too big}}
+sqlite3_limit db SQLITE_LIMIT_LENGTH 1000000000
+do_execsql_test 3.2 { SELECT rowid FROM ft($Z) } {301}
+
+finish_test
