--- a/test/vtab1.test
+++ b/test/vtab1.test
@@ -1556,6 +1556,47 @@
     SAVEPOINT c;
     RELEASE a;
   }
+
+  # A virtual table created within a savepoint that is not the
+  # transaction savepoint must also see a ROLLBACK TO that savepoint.
+  # At one point it did not, as sqlite3VtabCallCreate() did not invoke
+  # xSavepoint. So FTS kept the pending terms written by the INSERT
+  # below and the next SAVEPOINT or COMMIT failed with SQLITE_ERROR
+  # while trying to flush them to the rolled back shadow tables.
+  #
+  do_execsql_test 24.4.1 {
+    CREATE TABLE t6(x);
+    BEGIN;
+      INSERT INTO t6 VALUES(1);
+      SAVEPOINT a;
+        CREATE VIRTUAL TABLE t7 USING fts4(x);
+        INSERT INTO t7 VALUES('a b c');
+      ROLLBACK TO a;
+      SAVEPOINT b;
+    COMMIT;
+    SELECT * FROM t6;
+  } {1}
+  do_execsql_test 24.4.2 {
+    SELECT name FROM sqlite_schema WHERE name LIKE 't7%';
+  } {}
+  do_execsql_test 24.4.3 {
+    BEGIN;
+      INSERT INTO t6 VALUES(2);
+      SAVEPOINT a;
+        SAVEPOINT b;
+          CREATE VIRTUAL TABLE t7 USING fts3(x);
+          INSERT INTO t7 VALUES('a b c');
+        RELEASE b;
+      ROLLBACK TO a;
+      CREATE VIRTUAL TABLE t7 USING fts4(x);
+      INSERT INTO t7 VALUES('d e f');
+    COMMIT;
+    SELECT * FROM t6;
+    SELECT * FROM t7 WHERE t7 MATCH 'b OR e';
+  } {1 2 {d e f}}
+  do_execsql_test 24.4.4 {
+    INSERT INTO t7(t7) VALUES('integrity-check');
+  } {}
 }
 
