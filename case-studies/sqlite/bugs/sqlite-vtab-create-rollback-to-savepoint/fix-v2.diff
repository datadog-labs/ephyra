+++ b/ext/fts5/test/fts5savepoint.test
@@ -81,5 +81,52 @@
   }
 }
 
+#-------------------------------------------------------------------------
+# Check that a ROLLBACK TO that undoes a CREATE VIRTUAL TABLE also
+# discards the pending terms of the new table, even if the savepoint
+# is not the transaction savepoint.
+#
+reset_db
+do_execsql_test 4.0 {
+  CREATE TABLE t1(a);
+}
+do_execsql_test 4.1 {
+  BEGIN;
+    INSERT INTO t1 VALUES(1);
+    SAVEPOINT one;
+      CREATE VIRTUAL TABLE ft USING fts5(x);
+      INSERT INTO ft VALUES('a');
+    ROLLBACK TO one;
+    SAVEPOINT two;
+  COMMIT;
+  SELECT * FROM t1;
+} {1}
+do_execsql_test 4.2 {
+  SELECT name FROM sqlite_schema;
+} {t1}
+do_execsql_test 4.3 {
+  BEGIN;
+    SAVEPOINT one;
+      SAVEPOINT two;
+        CREATE VIRTUAL TABLE ft USING fts5(x);
+        INSERT INTO ft VALUES('a');
+      RELEASE two;
+    ROLLBACK TO one;
+    CREATE VIRTUAL TABLE ft USING fts5(x);
+    INSERT INTO ft VALUES('b');
+    SAVEPOINT three;
+      INSERT INTO ft VALUES('c');
+    ROLLBACK TO three;
+    INSERT INTO ft VALUES('d');
+  COMMIT;
+  SELECT * FROM ft;
+} {b d}
+do_execsql_test 4.4 {
+  SELECT rowid FROM ft('a OR c');
+} {}
+do_execsql_test 4.5 {
+  INSERT INTO ft(ft) VALUES('integrity-check');
+}
+
 finish_test
 
