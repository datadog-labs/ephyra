+/*
+** Return true if constant expression pExpr, with affinity aff applied, might
+** be -9223372036854775808, either as an INTEGER or as a REAL. Also return
+** true if the value of pExpr cannot be determined here. A helper for
+** wherePartIdxExpr(): an INT or NUMERIC column can hold both the INTEGER
+** and the REAL -9223372036854775808, which compare equal, and
+** sqlite3VdbeIntegerAffinity() does not convert one into the other, so the
+** constant cannot stand in for the column's value.
+*/
+static int wherePartIdxMaybeMinInt(sqlite3 *db, Expr *pExpr, u8 aff){
+  sqlite3_value *pVal = 0;
+  int bRet = 1;                   /* Assume the worst if value is unknown */
+  if( sqlite3ValueFromExpr(db, pExpr, ENC(db), aff, &pVal)==SQLITE_OK
+   && pVal!=0
+  ){
+    switch( sqlite3_value_type(pVal) ){
+      case SQLITE_INTEGER:
+        bRet = sqlite3_value_int64(pVal)==SMALLEST_INT64;
+        break;
+      case SQLITE_FLOAT:
+        bRet = sqlite3_value_double(pVal)==-9223372036854775808.0;
+        break;
+      default:
+        bRet = 0;
+        break;
+    }
   }
+  sqlite3ValueFree(pVal);
+  return bRet;
 }
 
