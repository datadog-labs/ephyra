--- a/test/tkt3922.test
+++ b/test/tkt3922.test
@@ -99,4 +99,31 @@
     AND typeof(b) = 'integer';
 } 1
 
+# An UPDATE that does not assign column a must not change how a is
+# stored.  Text that rounds to -9223372036854775808.0 is stored as a REAL
+# in an INTEGER column (tkt3922.2), and the index on a is not rewritten by
+# the UPDATE.
+do_execsql_test tkt3922.110 {
+  CREATE TABLE t2(a INT, b);
+  CREATE INDEX t2a ON t2(a);
+  INSERT INTO t2 VALUES('-9223372036854775809', 1);
+  UPDATE t2 SET b = 2;
+  SELECT typeof(a) FROM t2 NOT INDEXED;
+  SELECT typeof(a) FROM t2 INDEXED BY t2a WHERE a<0;
+} {real real}
+do_execsql_test tkt3922.111 {
+  CREATE TABLE t3(a INT, b, c, PRIMARY KEY(c, a)) WITHOUT ROWID;
+  CREATE INDEX t3c ON t3(c);
+  INSERT INTO t3 VALUES('-9223372036854775809', 1, 5);
+  UPDATE t3 SET b = 2;
+  SELECT typeof(a) FROM t3 NOT INDEXED;
+  SELECT typeof(a) FROM t3 INDEXED BY t3c WHERE c=5;
+  PRAGMA integrity_check;
+} {real real ok}
+do_execsql_test tkt3922.112 {
+  UPDATE t2 SET a = a;
+  SELECT typeof(a) FROM t2 NOT INDEXED;
+  SELECT typeof(a) FROM t2 INDEXED BY t2a WHERE a<0;
+} {integer integer}
+
 finish_test
