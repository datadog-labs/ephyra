+#-------------------------------------------------------------------------
+# An OR term on a table to the left of a RIGHT or FULL JOIN must not
+# drive a MULTI-INDEX OR loop unless it comes from the ON clause of
+# that table's own join. Other OR terms, from the WHERE clause or from
+# the ON clause of a join further right, are tested later, but the OR
+# loop marked them as coded, so they were never tested.
+#
+reset_db
+do_execsql_test 18.0 {
+  CREATE TABLE t0(a);
+  CREATE TABLE t1(a, b);
+  CREATE INDEX t1a ON t1(a);
+  CREATE TABLE t2(c);
+  CREATE TABLE t3(d);
+  INSERT INTO t0 VALUES(0);
+  INSERT INTO t1 VALUES(0, 1);
+  INSERT INTO t3 VALUES(7);
+  ANALYZE;
+  INSERT INTO t2 VALUES(9);
+}
+do_execsql_test 18.1 {
+  SELECT * FROM t0 JOIN t1 ON t1.a IN (t0.a) RIGHT JOIN t2 ON 1
+   WHERE t1.b IS 5 OR t1.a IS 5 ORDER BY t1.b;
+} {}
+do_execsql_test 18.2 {
+  SELECT * FROM t0 JOIN t1 ON t1.a IN (t0.a) RIGHT JOIN t2 ON 1
+   WHERE t1.b IS 1 OR t1.a IS 5 ORDER BY t1.b;
+} {0 0 1 9}
+optimization_control db simplify-join 0
+do_execsql_test 18.3 {
+  SELECT t1.a FROM t0 JOIN t1 ON t1.a IN (t0.a) FULL JOIN t2 ON NULL
+   WHERE t1.b = 5 OR t1.a = 5 ORDER BY t1.b;
+} {}
+do_execsql_test 18.4 {
+  SELECT count(*) FROM t0 JOIN t1 ON t1.a IN (t0.a) FULL JOIN t2 ON NULL
+   WHERE t1.b = 5 OR t1.a = 5 GROUP BY NULL;
+} {}
+optimization_control db all 1
+do_execsql_test 18.5 {
+  SELECT * FROM t0 JOIN t1 ON t1.a IN (t0.a)
+   JOIN t3 ON t1.b IS 5 OR t1.a IS 5 RIGHT JOIN t2 ON 1 ORDER BY t1.b;
+} {{} {} {} {} 9}
+do_execsql_test 18.6 {
+  SELECT * FROM t0 JOIN t1 ON t1.a IN (t0.a) RIGHT JOIN t2 ON 1
+   JOIN t3 ON t1.b IS 5 OR t1.a IS 5 ORDER BY t1.b;
+} {}
+do_execsql_test 18.7 {
+  SELECT * FROM t0 JOIN t1 ON t1.a IN (t0.a) AND (t1.b IS 5 OR t1.a IS 5)
+   RIGHT JOIN t2 ON 1 ORDER BY t1.b;
+} {{} {} {} 9}
+
 finish_test
