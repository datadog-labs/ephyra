+  5  '6'                      6
+  6  {' 6 '}                  6
+  7  '6.0'                    6
+  8  '6e0'                    6
+  9  '0.6e1'                  6
+  10 '1e1'                    10
+  11 '6abc'                   {}
+  12 'x'                      {}
+  13 '0x6'                    {}
+  14 x'36'                    {}
+  15 NULL                     {}
+  16 -0.0                     0
+  17 9223372036854775807      9223372036854775807
+  18 9223372036854775807.0    {}
+  19 '9223372036854775808'    {}
+  20 -9223372036854775808.0   -9223372036854775808
+  21 1e19                     {}
+  22 -1e19                    {}
+} {
+  execsql "DELETE FROM t2; INSERT INTO t2 VALUES($val)"
+  set inres [db eval "SELECT rowid FROM t1 WHERE rowid IN ($val, 7) ORDER BY 1"]
+  set joinres [db eval {
+    SELECT coalesce(t1.rowid, '-') FROM t2 LEFT JOIN t1 ON t1.rowid=t2.x
+  }]
+
+  do_execsql_test 27.$vn.0 "SELECT rowid FROM t1 WHERE rowid = $val" $eqres
+  foreach tbl $lTbl {
+    do_execsql_test 27.$vn.$tbl.1 "
+      SELECT rowid FROM $tbl WHERE rowid = $val
+    " $eqres
+    do_execsql_test 27.$vn.$tbl.2 "
+      SELECT rowid FROM $tbl WHERE rowid IN ($val, 7) ORDER BY 1
+    " $inres
+    do_execsql_test 27.$vn.$tbl.3 "
+      SELECT coalesce($tbl.rowid, '-') FROM t2
+        LEFT JOIN $tbl ON $tbl.rowid=t2.x
+    " $joinres
+  }
+}
