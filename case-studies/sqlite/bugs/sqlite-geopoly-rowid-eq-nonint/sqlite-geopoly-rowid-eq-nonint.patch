+#-------------------------------------------------------------------------
+# The "rowid = ?" constraint on an rtree or geopoly table is consumed by
+# xBestIndex (omit flag set), so xFilter must find exactly the rowid that
+# SQLite considers equal to the value, or no row at all if no integer is
+# equal to it. Results are compared with those of an ordinary table that
+# holds the same rowids.
+#
+reset_db
+do_execsql_test 27.0 {
+  CREATE TABLE t1(a);
+  CREATE TABLE t2(x);
+  INSERT INTO t1(rowid, a) VALUES
+    (-9223372036854775808, 1), (0, 1), (6, 1), (7, 1), (10, 1),
+    (9223372036854775807, 1);
+  CREATE VIRTUAL TABLE rt USING rtree(id, x0, x1);
+  INSERT INTO rt SELECT rowid, 0, 1 FROM t1;
+}
+set lTbl rt
+ifcapable geopoly {
+  do_execsql_test 27.0.1 {
+    CREATE VIRTUAL TABLE gp USING geopoly();
+    INSERT INTO gp(rowid, _shape) SELECT rowid, '[[0,0],[1,0],[0,1],[0,0]]'
+      FROM t1;
   }
+  lappend lTbl gp
 }
 
+foreach {vn val eqres} {
+  1  6                        6
+  2  6.0                      6
+  3  6.5                      {}
