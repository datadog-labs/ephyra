diff --git a/src/common/sort/natural_sort.cpp b/src/common/sort/natural_sort.cpp
index 6f94b06827..9f413b44cc 100644
--- a/src/common/sort/natural_sort.cpp
+++ b/src/common/sort/natural_sort.cpp
@@ -101,6 +101,12 @@ SinkCombineResultType NaturalSort::Combine(ExecutionContext &context, OperatorSi
 	auto &gstate = combine.global_state.Cast<NaturalSortGlobalSinkState>();
 	auto &lstate = combine.local_state.Cast<NaturalSortLocalSinkState>();
 
+	// Skip empty local collections: they still hold an (empty) chunk, which would become a zero-row block
+	// of the hash group if used as the base collection.
+	if (!lstate.unsorted || !lstate.unsorted->Count()) {
+		return SinkCombineResultType::FINISHED;
+	}
+
 	// Only one partition, so need a global lock.
 	annotated_lock_guard<annotated_mutex> glock(gstate.lock);
 	auto &hash_group = gstate.hash_group;
