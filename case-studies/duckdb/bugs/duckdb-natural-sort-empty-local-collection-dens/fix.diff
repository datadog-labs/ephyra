+++ b/test/sql/window/test_natural_sort_empty_combine.test
@@ -0,0 +1,18 @@
+# name: test/sql/window/test_natural_sort_empty_combine.test
+# description: OVER () must not see a zero-row block when an empty thread-local collection is combined first
+# group: [window]
+
+statement ok
+PRAGMA enable_verification
+
+foreach threads 1 2 4
+
+statement ok
+SET threads=${threads};
+
+query II
+SELECT x, dense_rank() OVER () FROM (VALUES (7), (NULL)) t(x) ANTI JOIN (VALUES (7), (2), (1)) s(y) ON x = y AND NULL::BOOLEAN WHERE x IS NULL;
+----
+NULL	1
+
+endloop
