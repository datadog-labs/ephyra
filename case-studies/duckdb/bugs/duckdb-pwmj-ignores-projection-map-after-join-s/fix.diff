+# name: test/sql/subquery/scalar/test_subquery_outer_join_condition_nlj.test
+# description: Uncorrelated subqueries in an outer join condition below a nested loop join
+# group: [scalar]
+
+statement ok
+CREATE TABLE t0(c0 INTEGER);
+
+statement ok
+INSERT INTO t0 VALUES (1), (2);
+
+query III
+SELECT x1.c0, x2.c0, x3.c0 FROM t0 AS x1 FULL JOIN t0 AS x2 ON ((SELECT 0) <> (SELECT count(*) FROM t0 WHERE c0 > 1)) AND x1.c0 < x2.c0 JOIN (VALUES (2), (8)) AS x3(c0) ON (x2.c0 <> x3.c0) ORDER BY ALL
+----
+1	2	8
+NULL	1	2
+NULL	1	8
+
+query I
+SELECT count(*) FROM t0 AS x1 FULL JOIN t0 AS x2 ON ((SELECT 0) <> (SELECT count(*) FROM t0)) JOIN (VALUES (7), (8), (9)) AS x3(c0) ON (x2.c0 <> x3.c0)
+----
+12
+
+query I
+SELECT count(*) FROM t0 AS x1 LEFT JOIN t0 AS x2 ON ('' NOT IN (SELECT '' FROM t0 WHERE false)) JOIN t0 AS x4 ON x1.c0 <> x4.c0
+----
+4
