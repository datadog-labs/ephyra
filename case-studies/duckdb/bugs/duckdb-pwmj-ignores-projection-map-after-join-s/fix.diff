+
+PhysicalOperator &PhysicalPlanGenerator::PlanJoinWithoutProjectionMaps(
+    LogicalJoin &op, PhysicalOperator &left, PhysicalOperator &right,
+    const std::function<PhysicalOperator &()> &plan_join) {
+	if (op.left_projection_map.empty() && op.right_projection_map.empty()) {
+		return plan_join();
+	}
+	// the layout the join produces without projection maps, and the columns of it that the projection maps select
+	vector<LogicalType> join_types;
+	vector<idx_t> projected_columns;
+	auto add_side = [&](const vector<LogicalType> &side_types, const vector<ProjectionIndex> &projection_map) {
+		auto offset = join_types.size();
+		if (projection_map.empty()) {
+			for (idx_t i = 0; i < side_types.size(); i++) {
+				projected_columns.push_back(offset + i);
+			}
+		} else {
+			for (auto &projection_index : projection_map) {
+				projected_columns.push_back(offset + projection_index.GetIndex());
+			}
+		}
+		join_types.insert(join_types.end(), side_types.begin(), side_types.end());
+	};
+	switch (op.join_type) {
+	case JoinType::SEMI:
+	case JoinType::ANTI:
+		add_side(left.GetTypes(), op.left_projection_map);
+		break;
+	case JoinType::MARK:
+		add_side(left.GetTypes(), op.left_projection_map);
+		projected_columns.push_back(join_types.size());
+		join_types.emplace_back(LogicalType::BOOLEAN);
+		break;
+	case JoinType::RIGHT_SEMI:
+	case JoinType::RIGHT_ANTI:
+		add_side(right.GetTypes(), op.right_projection_map);
+		break;
+	default:
+		add_side(left.GetTypes(), op.left_projection_map);
+		add_side(right.GetTypes(), op.right_projection_map);
+		break;
+	}
+	auto projected_types = op.types;
+	D_ASSERT(projected_types.size() == projected_columns.size());
+	op.left_projection_map.clear();
+	op.right_projection_map.clear();
+	op.types = std::move(join_types);
+	auto &join = plan_join();
+
+	vector<unique_ptr<Expression>> select_list;
+	for (idx_t i = 0; i < projected_columns.size(); i++) {
+		select_list.push_back(make_uniq<BoundReferenceExpression>(projected_types[i], projected_columns[i]));
+	}
+	auto &proj = Make<PhysicalProjection>(std::move(projected_types), std::move(select_list), op.estimated_cardinality);
+	proj.children.push_back(join);
+	return proj;
 }
 
