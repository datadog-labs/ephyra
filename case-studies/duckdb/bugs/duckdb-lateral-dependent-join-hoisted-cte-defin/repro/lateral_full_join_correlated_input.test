# name: test/sql/subquery/lateral/lateral_full_join_correlated_input.test
# group: [lateral]

statement ok
CREATE TABLE t(x INT);

statement ok
INSERT INTO t VALUES (1), (2), (NULL);

query I
SELECT count(*) FROM t a, (SELECT (SELECT x) y FROM t) b FULL JOIN t c ON (SELECT a.x + b.y + c.x) = 4;
----
15

query I
SELECT count(*) FROM t a, t c FULL JOIN (SELECT (SELECT x) y FROM t) b ON (SELECT a.x + b.y + c.x) = 4;
----
15
