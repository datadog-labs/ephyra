index 0000000000..188896a29d
--- /dev/null
+++ b/test/sql/join/hash_join/test_hash_join_zero_probe_columns.test
@@ -0,0 +1,24 @@
+# name: test/sql/join/hash_join/test_hash_join_zero_probe_columns.test
+# description: Hash join whose probe side has no columns must not fail when sizing the probe-side spill
+# group: [hash_join]
+
+statement ok
+CREATE TABLE t1(c0 INTEGER);
+
+statement ok
+SET disabled_optimizers='unused_columns';
+
+query I
+SELECT 0 FROM t1 HAVING 0 IN (SELECT 0 FROM t1);
+----
+
+query I
+SELECT 0 FROM range(3) HAVING 0 IN (SELECT 0 FROM t1);
+----
+
+statement ok
+SET debug_force_external=true;
+
+query I
+SELECT 0 FROM range(3) HAVING 0 IN (SELECT 0 FROM t1);
+----
