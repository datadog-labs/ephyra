+++ b/test/optimizer/statistics/statistics_table_filter_folded_column.test
@@ -0,0 +1,33 @@
+# name: test/optimizer/statistics/statistics_table_filter_folded_column.test
+# description: A table filter whose column is simplified away by statistics is folded instead of kept without a column
+# group: [statistics]
+
+statement ok
+CREATE TABLE t0(c0 INTEGER);
+
+# the mark join triggers a second statistics propagation pass over the same table filter
+query I
+SELECT count(*) FROM t0 WHERE (c0 IS NULL) IN (NULL, true) AND (c0 = 1 OR 0 IN (SELECT 0))
+----
+0
+
+statement ok
+INSERT INTO t0 VALUES (1), (2);
+
+query I
+SELECT count(*) FROM t0 WHERE (c0 IS NULL) IN (NULL, true) AND (c0 = 1 OR 0 IN (SELECT 0))
+----
+0
+
+query I
+SELECT count(*) FROM t0 WHERE (c0 IS NOT NULL) IN (NULL, true) AND (c0 = 1 OR 0 IN (SELECT 0))
+----
+2
+
+statement ok
+INSERT INTO t0 VALUES (NULL);
+
+query I
+SELECT count(*) FROM t0 WHERE (c0 IS NULL) IN (NULL, true) AND (c0 = 1 OR 0 IN (SELECT 0))
+----
+1
