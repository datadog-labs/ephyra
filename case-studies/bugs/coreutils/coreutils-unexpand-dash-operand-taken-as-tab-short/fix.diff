+
+#[test]
+fn test_dash_operand_is_stdin_not_shortcut() {
+    // A bare "-" must not be taken for a "-N" shortcut (which implies --first-only)
+    new_ucmd!()
+        .args(&["-t", "3", "-"])
+        .pipe_in("a  ")
+        .succeeds()
+        .stdout_is("a\t");
+    let (at, mut ucmd) = at_and_ucmd!();
+    at.write("f", "X\n");
+    ucmd.args(&["-", "f"])
+        .pipe_in("S\n")
+        .succeeds()
+        .stdout_is("S\nX\n");
+}
