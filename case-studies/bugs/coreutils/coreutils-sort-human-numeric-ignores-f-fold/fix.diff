+#[test]
+fn test_human_numeric_ignore_case() {
+    // With -f, lowercase SI suffixes count as their uppercase equivalents.
+    new_ucmd!()
+        .args(&["-h", "-f"])
+        .pipe_in("1e\n2m\n1K\n3g\n5\n")
+        .succeeds()
+        .stdout_only("5\n1K\n2m\n3g\n1e\n");
+    new_ucmd!()
+        .arg("-k2,2hf")
+        .pipe_in("a 1e\nb 1K\n")
+        .succeeds()
+        .stdout_only("b 1K\na 1e\n");
+    // Without -f, a lowercase suffix other than k is not a suffix.
+    new_ucmd!()
+        .arg("-h")
+        .pipe_in("1e\n1K\n")
+        .succeeds()
+        .stdout_only("1e\n1K\n");
+}
