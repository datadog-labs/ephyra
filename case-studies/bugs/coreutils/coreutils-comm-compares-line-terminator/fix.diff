+///
+/// Both lines end with their terminator (`LineReader::read_line` guarantees
+/// it), which is not part of the line and must not take part in the
+/// comparison: `""` sorts before `"\t"`, yet `"\n"` is greater than `"\t\n"`.
 fn line_cmp(a: &[u8], b: &[u8], use_locale: bool) -> Ordering {
+    let a = a.split_last().map_or(a, |(_, line)| line);
+    let b = b.split_last().map_or(b, |(_, line)| line);
     if use_locale {
         locale_cmp(a, b)
     } else {
diff --git a/tests/by-util/test_comm.rs b/tests/by-util/test_comm.rs
