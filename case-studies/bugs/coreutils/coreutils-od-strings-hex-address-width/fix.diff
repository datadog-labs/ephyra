+// -S prints offsets with the same width as the normal dump: 6 hex digits with -Ax.
+#[test]
+fn test_strings_address_radix_width() {
+    for (radix, expected) in [
+        ("-Ax", "000002 abc\n"),
+        ("-Ad", "0000002 abc\n"),
+        ("-Ao", "0000002 abc\n"),
+    ] {
+        new_ucmd!()
+            .args(&[radix, "-S", "3"])
+            .pipe_in("\0\0abc\0")
+            .succeeds()
+            .stdout_only(expected);
+    }
+}
