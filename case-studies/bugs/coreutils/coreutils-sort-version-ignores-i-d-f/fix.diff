+#[test]
+fn test_version_sort_honors_key_filters() {
+    // -f folds case before the version comparison
+    new_ucmd!()
+        .arg("-fV")
+        .pipe_in("B\na\n")
+        .succeeds()
+        .stdout_is("a\nB\n");
+    new_ucmd!()
+        .arg("-k1fV")
+        .pipe_in("B\na\n")
+        .succeeds()
+        .stdout_is("a\nB\n");
+    // -d drops non-alphanumeric characters
+    new_ucmd!()
+        .arg("-dV")
+        .pipe_in("b\n_a\n")
+        .succeeds()
+        .stdout_is("_a\nb\n");
+    // -i drops the tab, so the second key is empty and sorts first
+    new_ucmd!()
+        .args(&["-c", "-iV"])
+        .pipe_in("0\n\t\n")
+        .fails_with_code(1);
+}
