+
+/// Apply `-i`, `-d` and `-f` to a key, for orderings that compare the resulting
+/// string as a whole (like `-V`) instead of character by character.
+pub fn filter_str(
+    s: &[u8],
+    ignore_non_printing: bool,
+    ignore_non_dictionary: bool,
+    ignore_case: bool,
+) -> Cow<'_, [u8]> {
+    if !(ignore_case || ignore_non_dictionary || ignore_non_printing) {
+        return Cow::Borrowed(s);
+    }
+    Cow::Owned(
+        s.iter()
+            .filter(|&&c| filter_char(c, ignore_non_printing, ignore_non_dictionary))
+            .map(|&c| if ignore_case { c.to_ascii_uppercase() } else { c })
+            .collect(),
+    )
+}
