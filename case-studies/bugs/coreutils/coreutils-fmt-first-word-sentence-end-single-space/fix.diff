+
+#[test]
+fn test_fmt_first_word_sentence_end_at_line_end() {
+    // A first word ending a sentence at end of line is followed by two spaces when joined.
+    for args in [&[][..], &["-u"], &["-q"]] {
+        new_ucmd!()
+            .args(args)
+            .pipe_in("a.\nz\n")
+            .succeeds()
+            .stdout_is("a.  z\n");
+    }
+    new_ucmd!().pipe_in(".\nz").succeeds().stdout_is(".  z\n");
+}
