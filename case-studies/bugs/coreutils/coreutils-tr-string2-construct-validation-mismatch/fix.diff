diff --git a/tests/by-util/test_tr.rs b/tests/by-util/test_tr.rs
index 2262f8987..4d654cfb3 100644
--- a/tests/by-util/test_tr.rs
+++ b/tests/by-util/test_tr.rs
@@ -2058,3 +2058,89 @@ string2 must map all characters in the domain to one
             .stderr_only("tr: the [c*] repeat construct may not appear in string1\n");
     }
 }
+
+#[test]
+fn test_delete_squeeze_any_class_in_set2() {
+    // Not translating: case classes need no counterpart in set1.
+    new_ucmd!()
+        .args(&["-ds", "a", "[:lower:]"])
+        .pipe_in("xaab\n")
+        .succeeds()
+        .stdout_only("xb\n");
+    new_ucmd!()
+        .args(&["-ds", "[:print:]", "x[:upper:]"])
+        .pipe_in("ab\n\n")
+        .succeeds()
+        .stdout_only("\n\n");
+}
+
+#[test]
+fn test_complement_case_class_in_set2() {
+    new_ucmd!()
+        .args(&["-c", "a", "b[:lower:]b"])
+        .pipe_in("xaAb\n")
+        .succeeds()
+        .stdout_is("babbj");
+}
+
+#[test]
+fn test_equivalence_class_in_set2_when_translating() {
+    for args in [&["a", "[=a=]"][..], &["-c", "ab", "[=a=]"], &["-s", "a", "[=a=]"]] {
+        new_ucmd!()
+            .args(args)
+            .fails_with_code(1)
+            .stderr_only("tr: [=c=] expressions may not appear in string2 when translating\n");
+    }
+    new_ucmd!()
+        .args(&["-ds", "a", "[=b=]"])
+        .pipe_in("abbc")
+        .succeeds()
+        .stdout_only("bc");
+}
+
+#[test]
+fn test_char_star_in_set2_when_not_translating() {
+    for set2 in ["[b*]", "[b*0]"] {
+        new_ucmd!()
+            .args(&["-ds", "a", set2])
+            .fails_with_code(1)
+            .stderr_only("tr: the [c*] construct may appear in string2 only when translating\n");
+    }
+    new_ucmd!()
+        .args(&["-s", "a", "[b*]"])
+        .pipe_in("xaab\n")
+        .succeeds()
+        .stdout_only("xb\n");
+}
+
+#[test]
+fn test_case_class_alignment_in_set2() {
+    // set2's case class must line up with an upper/lower class in set1 ...
+    for (set1, set2) in [
+        ("[:xdigit:]", "[:upper:]"),
+        ("[:alpha:]", "[:upper:]"),
+        ("a", "b[:lower:]"),
+        ("[:upper:][:upper:]", "[:lower:]x[:lower:]"),
+    ] {
+        new_ucmd!()
+            .args(&[set1, set2])
+            .fails_with_code(1)
+            .stderr_contains("must be matched by a 'upper'/'lower'");
+    }
+    // ... unless it starts past the end of set1, where it is never used
+    new_ucmd!()
+        .args(&["a", "ab[:lower:]"])
+        .pipe_in("xaAb\n")
+        .succeeds()
+        .stdout_only("xaAb\n");
+    new_ucmd!()
+        .args(&["[:upper:]", "[:lower:]x[:lower:]"])
+        .pipe_in("xaAb\n")
+        .succeeds()
+        .stdout_only("xaab\n");
+    new_ucmd!()
+        .args(&["[:lower:]", "[:lower:]"])
+        .pipe_in("xaAb\n")
+        .succeeds()
+        .stdout_only("xaAb\n");
+}
