+#[test]
+fn test_control_characters_take_one_column() {
+    new_ucmd!()
+        .args(&["-w", "1"])
+        .pipe_in("\x0c0")
+        .succeeds()
+        .stdout_is("\x0c\n0");
+    new_ucmd!()
+        .args(&["-w", "2"])
+        .pipe_in("\x01\x07\x0b\x1b\x7f")
+        .succeeds()
+        .stdout_is("\x01\x07\n\x0b\x1b\n\x7f");
+    new_ucmd!()
+        .args(&["-w", "2"])
+        .pipe_in("\u{e9}\x01\x01")
+        .succeeds()
+        .stdout_is("\u{e9}\x01\n\x01");
+}
+
+#[test]
+fn test_nul_takes_no_column() {
+    new_ucmd!()
+        .args(&["-w", "2"])
+        .pipe_in(b"ab\0\0c".as_slice())
+        .succeeds()
+        .stdout_is_bytes(b"ab\0\0\nc");
+    new_ucmd!()
+        .args(&["-w", "2"])
+        .pipe_in(b"a\xff\0\0b".as_slice())
+        .succeeds()
+        .stdout_is_bytes(b"a\xff\0\0\nb");
+}
+
+#[test]
+fn test_control_character_at_width_in_characters_mode() {
+    // No extra newline when a control character exactly fills the line.
+    new_ucmd!()
+        .args(&["-c", "-w", "2"])
+        .pipe_in("a\x01")
+        .succeeds()
+        .stdout_is("a\x01");
+    new_ucmd!()
+        .args(&["-c", "-w", "2"])
+        .pipe_in("a\x01\n")
+        .succeeds()
+        .stdout_is("a\x01\n");
+}
