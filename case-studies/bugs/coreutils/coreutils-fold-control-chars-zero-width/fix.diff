+/// Display width of `ch` in column mode. NUL takes no space, but every other
+/// ASCII control character (except tab, backspace and carriage return, which
+/// callers handle themselves) occupies one column, matching GNU fold.
+fn char_columns(ch: char) -> usize {
+    match ch {
+        '\0' => 0,
+        c if c.is_ascii_control() => 1,
+        c => UnicodeWidthChar::width(c).unwrap_or(0),
+    }
+}
