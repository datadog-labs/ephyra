+#[test]
+fn test_number_separator_unnumbered_line_padding() {
+    // unnumbered lines are padded to the width of the number plus the separator
+    new_ucmd!()
+        .args(&["-s", ":-:"])
+        .pipe_in("a\n\nb\n")
+        .succeeds()
+        .stdout_is("     1:-:a\n         \n     2:-:b\n");
+    new_ucmd!()
+        .args(&["-s", ""])
+        .pipe_in("a\n\n")
+        .succeeds()
+        .stdout_is("     1a\n      \n");
+}
