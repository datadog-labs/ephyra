+#[test]
+fn test_form_feed_and_carriage_return_are_not_blanks() {
+    // Only space and tab are blanks in the C locale.
+    for (args, input, expected) in [
+        (&["-n"][..], "b\n\x0c2\n", "\x0c2\nb\n"),
+        (&["-n"][..], "b\n\r2\n", "\r2\nb\n"),
+        (&["-b"][..], " a\n\x0cb\n", "\x0cb\n a\n"),
+        (&["-k2b"][..], "a b\nc\rz\n", "c\rz\na b\n"),
+        (&["-d"][..], "a\x0cc\nab\n", "ab\na\x0cc\n"),
+    ] {
+        new_ucmd!()
+            .env("LC_ALL", "C")
+            .args(args)
+            .pipe_in(input)
+            .succeeds()
+            .stdout_only(expected);
+    }
+}
