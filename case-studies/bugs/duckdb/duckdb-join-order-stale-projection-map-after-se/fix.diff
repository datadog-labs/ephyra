 #include "duckdb/optimizer/join_order/plan_enumerator.hpp"
 #include "duckdb/planner/expression/list.hpp"
 #include "duckdb/planner/operator/list.hpp"
+#include "duckdb/planner/logical_operator_visitor.hpp"
 
 namespace duckdb {
 
@@ -41,6 +42,60 @@ static optional<RelationStats> CombineReorderableStats(const vector<ColumnBindin
 	return result;
 }
 
+//! The child bindings that a positional projection map selects from, before join reordering
+struct ProjectionMapBindings {
+	idx_t child_index;
+	vector<ColumnBinding> child_bindings;
+};
+using projection_map_bindings_t = unordered_map<LogicalOperator *, vector<ProjectionMapBindings>>;
+
+static void CollectProjectionMapBindings(LogicalOperator &op, projection_map_bindings_t &result) {
+	if (op.HasProjectionMap()) {
+		for (idx_t child_index = 0; child_index < op.children.size(); child_index++) {
+			auto projection_map = LogicalOperatorVisitor::GetProjectionMap(op, child_index);
+			if (projection_map && !projection_map->empty()) {
+				result[&op].push_back({child_index, op.children[child_index]->GetColumnBindings()});
+			}
+		}
+	}
+	for (auto &child : op.children) {
+		CollectProjectionMapBindings(*child, result);
+	}
+}
+
+//! Reordering joins can change the column order of a reordered subtree, but projection maps (e.g. the one of the
+//! filter LogicalJoin::PromoteJoinSide places above a join replaced by a cross product) refer to child columns by
+//! position: translate them to the new positions of the bindings they selected
+static void RemapProjectionMaps(LogicalOperator &op, const projection_map_bindings_t &before) {
+	auto entry = before.find(&op);
+	if (entry != before.end()) {
+		for (auto &child_entry : entry->second) {
+			auto projection_map = LogicalOperatorVisitor::GetProjectionMap(op, child_entry.child_index);
+			if (!projection_map || projection_map->empty() || child_entry.child_index >= op.children.size()) {
+				continue;
+			}
+			auto child_bindings = op.children[child_entry.child_index]->GetColumnBindings();
+			if (child_bindings == child_entry.child_bindings) {
+				continue;
+			}
+			vector<ProjectionIndex> new_projection_map;
+			for (auto &projection_index : *projection_map) {
+				auto &binding = child_entry.child_bindings[projection_index.GetIndex()];
+				auto position = std::find(child_bindings.begin(), child_bindings.end(), binding);
+				if (position == child_bindings.end()) {
+					throw InternalException("Join order optimizer lost binding %s selected by a projection map",
+					                        binding.ToString());
+				}
+				new_projection_map.emplace_back(NumericCast<idx_t>(position - child_bindings.begin()));
+			}
+			*projection_map = std::move(new_projection_map);
+		}
+	}
+	for (auto &child : op.children) {
+		RemapProjectionMaps(*child, before);
+	}
+}
+
 JoinOrderOptimizer::JoinOrderOptimizer(ClientContext &context)
     : context(context), query_graph_manager(context), depth(1) {
 }
