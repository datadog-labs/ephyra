+	projection_map_bindings_t projection_map_bindings;
+	if (depth == 1) {
+		CollectProjectionMapBindings(*plan, projection_map_bindings);
+	}
+
 	// make sure query graph manager has not extracted a relation graph already
 	LogicalOperator *op = plan.get();
 
@@ -118,6 +178,10 @@ unique_ptr<LogicalOperator> JoinOrderOptimizer::Optimize(unique_ptr<LogicalOpera
 		new_logical_plan->EstimateCardinality(context);
 	}
 
+	if (!projection_map_bindings.empty()) {
+		RemapProjectionMaps(*new_logical_plan, projection_map_bindings);
+	}
+
 	if (new_logical_plan->type == LogicalOperatorType::LOGICAL_EXPLAIN) {
 		new_logical_plan->SetEstimatedCardinality(3);
 	}
