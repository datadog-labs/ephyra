+#-------------------------------------------------------------------------
+# The "rowid = ?" constraint is consumed by xBestIndex (omit flag set). With
+# a MATCH, xFilter applies it as a range of rowids, so the range must hold
+# exactly the rowids SQLite considers equal to the value: none for a value
+# that is not equal to any integer. Results are compared with those of an
+# ordinary table holding the same rows.
+#
+reset_db
+do_execsql_test 2.0 {
+  CREATE TABLE t1(a);
+  CREATE TABLE t2(x);
+  INSERT INTO t1(rowid, a) VALUES
+    (-9223372036854775808, 'apple'), (1, 'apple'), (2, 'apple'),
+    (3, 'apple pie'), (9223372036854775807, 'apple');
+}
+
+foreach {tn create} {
+  1 { CREATE VIRTUAL TABLE ft USING fts5(a) }
+  2 { CREATE VIRTUAL TABLE ft USING fts5(a, content='') }
+  3 { CREATE VIRTUAL TABLE ft USING fts5(a, detail=none) }
+  4 { CREATE VIRTUAL TABLE ft USING fts5(a, content=t1) }
+} {
+  execsql { DROP TABLE IF EXISTS ft }
+  do_execsql_test 2.$tn.0 "
+    $create;
+    INSERT INTO ft(rowid, a) SELECT rowid, a FROM t1;
+  "
+
+  foreach {vn val res} {
+    1  2                       2
+    2  2.0                     2
+    3  2.5                     {}
+    4  '2'                     2
+    5  {' 2 '}                 2
+    6  '2.0'                   2
+    7  '2e0'                   2
+    8  '0x2'                   {}
+    9  'x'                     {}
+    10 x'32'                   {}
+    11 NULL                    {}
+    12 9223372036854775807     9223372036854775807
+    13 9223372036854775807.0   {}
+    14 -9223372036854775808.0  -9223372036854775808
+    15 1e19                    {}
+    16 -1e19                   {}
+  } {
+    execsql "DELETE FROM t2; INSERT INTO t2 VALUES($val)"
+    set inres [db eval "
+      SELECT rowid FROM t1 WHERE rowid IN ($val, 3) ORDER BY 1
+    "]
+    set joinres [db eval {
+      SELECT coalesce(t1.rowid, '-') FROM t2
+        LEFT JOIN t1 ON t1.rowid=t2.x AND t1.a='apple pie'
+    }]
+
+    do_execsql_test 2.$tn.$vn.1 "
+      SELECT rowid FROM t1 WHERE rowid = $val
+    " $res
+    do_execsql_test 2.$tn.$vn.2 "
+      SELECT rowid FROM ft WHERE ft MATCH 'apple' AND rowid = $val
+    " $res
+    do_execsql_test 2.$tn.$vn.3 "
+      SELECT rowid FROM ft WHERE ft MATCH 'apple' AND rowid = $val
+      ORDER BY rowid DESC
+    " $res
+    do_execsql_test 2.$tn.$vn.4 "
+      SELECT rowid FROM ft WHERE ft MATCH 'apple' AND rowid = $val
+      ORDER BY rank
+    " $res
+    do_execsql_test 2.$tn.$vn.5 "
+      SELECT rowid FROM ft WHERE ft MATCH 'apple' AND rowid IN ($val, 3)
+      ORDER BY 1
+    " $inres
+    do_execsql_test 2.$tn.$vn.6 {
+      SELECT coalesce(ft.rowid, '-') FROM t2
+        LEFT JOIN ft ON ft.rowid=t2.x AND ft MATCH 'pie'
+    } $joinres
+  }
+}
+
+reset_db
+do_execsql_test 3.0 {
+  CREATE VIRTUAL TABLE ft USING fts5(a);
+  INSERT INTO ft(rowid, a) VALUES (1, 'apple'), (2, 'apple'), (3, 'apple pie');
+  CREATE TABLE t1(x);
+  INSERT INTO t1 VALUES (3), (2.5), ('x');
+}
+do_execsql_test 3.1 {
+  SELECT count(*) FROM ft WHERE ft MATCH 'apple' AND rowid = 2.5;
+} {0}
+do_execsql_test 3.2 {
+  SELECT count(*) FROM ft WHERE ft MATCH 'apple' AND rowid = 'x';
+} {0}
+do_execsql_test 3.3 {
+  SELECT rowid FROM ft WHERE ft MATCH 'apple' AND rowid = 2.0;
+} {2}
+do_execsql_test 3.4 {
+  SELECT t1.x, ft.rowid FROM t1 LEFT JOIN ft ON ft.rowid=t1.x AND ft MATCH 'pie';
+} {3 3 2.5 {} x {}}
+do_execsql_test 3.5 {
+  SELECT count(*) FROM ft WHERE ft MATCH 'apple' AND rowid IN (2.5, 'x');
+} {0}
+do_execsql_test 3.6 {
+  SELECT rowid FROM ft WHERE ft MATCH 'apple' AND rowid IN (2.5, 'x', 3.0);
+} {3}
+
 finish_test
