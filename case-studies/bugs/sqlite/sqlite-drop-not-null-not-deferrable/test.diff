--- a/test/altercons.test
+++ b/test/altercons.test
@@ -495,5 +495,90 @@
 do_catchsql_test 11.4.2 {
   INSERT INTO t1 VALUES(5, 1, 0);
 } {1 {CHECK constraint failed: c2}}
+
+#-------------------------------------------------------------------------
+# DROP NOT NULL and SET NOT NULL do not take the NOT of a "NOT DEFERRABLE"
+# clause for a NOT NULL constraint, and removing a NOT NULL or CHECK
+# constraint does not remove a deferral clause that follows it.
+#
+reset_db
+foreach {tn before alter after} {
+  1 "CREATE TABLE c1(b REFERENCES p1 NOT DEFERRABLE NOT NULL, c)"
+    "ALTER TABLE c1 ALTER b DROP NOT NULL"
+    "CREATE TABLE c1(b REFERENCES p1 NOT DEFERRABLE, c)"
+
+  2 "CREATE TABLE c1(b REFERENCES p1 NOT DEFERRABLE CONSTRAINT nn NOT NULL)"
+    "ALTER TABLE c1 ALTER b DROP NOT NULL"
+    "CREATE TABLE c1(b REFERENCES p1 NOT DEFERRABLE)"
+
+  3 "CREATE TABLE c1(b REFERENCES p1 CONSTRAINT d NOT DEFERRABLE NOT NULL)"
+    "ALTER TABLE c1 ALTER b DROP NOT NULL"
+    "CREATE TABLE c1(b REFERENCES p1 CONSTRAINT d NOT DEFERRABLE)"
+
+  4 "CREATE TABLE c1(b REFERENCES p1 NOT DEFERRABLE, c)"
+    "ALTER TABLE c1 ALTER b SET NOT NULL"
+    "CREATE TABLE c1(b REFERENCES p1 NOT DEFERRABLE NOT NULL, c)"
 
+  5 "CREATE TABLE c1(b REFERENCES p1 NOT NULL DEFERRABLE INITIALLY DEFERRED)"
+    "ALTER TABLE c1 ALTER b DROP NOT NULL"
+    "CREATE TABLE c1(b REFERENCES p1 DEFERRABLE INITIALLY DEFERRED)"
+
+  6 "CREATE TABLE c1(b REFERENCES p1 CONSTRAINT nn NOT NULL
+       DEFERRABLE INITIALLY DEFERRED, c)"
+    "ALTER TABLE c1 ALTER b DROP NOT NULL"
+    "CREATE TABLE c1(b REFERENCES p1 DEFERRABLE INITIALLY DEFERRED, c)"
+
+  7 "CREATE TABLE c1(b REFERENCES p1 NOT NULL DEFERRABLE INITIALLY DEFERRED)"
+    "ALTER TABLE c1 ALTER b SET NOT NULL"
+    "CREATE TABLE c1(b REFERENCES p1 DEFERRABLE INITIALLY DEFERRED NOT NULL)"
+
+  8 "CREATE TABLE c1(b REFERENCES p1 CONSTRAINT c CHECK(b>0)
+       DEFERRABLE INITIALLY DEFERRED)"
+    "ALTER TABLE c1 DROP CONSTRAINT c"
+    "CREATE TABLE c1(b REFERENCES p1 DEFERRABLE INITIALLY DEFERRED)"
+
+  9 "CREATE TABLE c1(b REFERENCES p1 CONSTRAINT nn NOT NULL
+       DEFERRABLE INITIALLY DEFERRED)"
+    "ALTER TABLE c1 DROP CONSTRAINT nn"
+    "CREATE TABLE c1(b REFERENCES p1 DEFERRABLE INITIALLY DEFERRED)"
+
+  10 "CREATE TABLE c1(b REFERENCES p1
+        CONSTRAINT d NOT DEFERRABLE INITIALLY IMMEDIATE NOT NULL, c)"
+     "ALTER TABLE c1 ALTER b DROP NOT NULL"
+     "CREATE TABLE c1(b REFERENCES p1
+        CONSTRAINT d NOT DEFERRABLE INITIALLY IMMEDIATE, c)"
+
+  11 "CREATE TABLE c1(b REFERENCES p1
+        CONSTRAINT d NOT DEFERRABLE INITIALLY IMMEDIATE NOT NULL, c)"
+     "ALTER TABLE c1 DROP CONSTRAINT d"
+     "CREATE TABLE c1(b REFERENCES p1 NOT NULL, c)"
+} {
+  do_execsql_test 12.$tn.1 { DROP TABLE IF EXISTS c1 }
+  do_execsql_test 12.$tn.2 $before
+  do_execsql_test 12.$tn.3 $alter
+  do_execsql_test 12.$tn.4 {
+    SELECT sql FROM sqlite_schema WHERE name='c1'
+  } [list $after]
+}
+
+do_catchsql_test 12.12 {
+  INSERT INTO c1 VALUES(NULL, NULL);
+} {1 {NOT NULL constraint failed: c1.b}}
+
+reset_db
+do_execsql_test 13.0 {
+  CREATE TABLE p1(a PRIMARY KEY);
+  CREATE TABLE c1(b REFERENCES p1 NOT NULL DEFERRABLE INITIALLY DEFERRED);
+  ALTER TABLE c1 ALTER b DROP NOT NULL;
+  PRAGMA foreign_keys = 1;
+}
+do_execsql_test 13.1 {
+  BEGIN;
+    INSERT INTO c1 VALUES(1);
+    INSERT INTO p1 VALUES(1);
+  COMMIT;
+  INSERT INTO c1 VALUES(NULL);
+  SELECT * FROM c1;
+} {1 {}}
+
 finish_test
