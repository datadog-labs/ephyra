+/*
+** Return a reference "SCHEMA.TABLE.zName" to column zName of the table
+** pItem, the form selectExpander() uses for the columns of a "*". Return
+** NULL on OOM.
+*/
+static Expr *selectExpandQualifiedColumn(
+  Parse *pParse,          /* Parsing context */
+  SrcItem *pItem,         /* The table */
+  const char *zName       /* Name of the column */
+){
+  sqlite3 *db = pParse->db;
+  const char *zTabName = pItem->zAlias ? pItem->zAlias : pItem->pSTab->zName;
+  int iDb = sqlite3SchemaToIndex(db, pItem->pSTab->pSchema);
+  const char *zSchemaName = iDb>=0 ? db->aDb[iDb].zDbSName : "*";
+  Expr *pE;
+  pE = sqlite3PExpr(pParse, TK_DOT, sqlite3Expr(db, TK_ID, zTabName),
+                                    sqlite3Expr(db, TK_ID, zName));
+  pE = sqlite3PExpr(pParse, TK_DOT, sqlite3Expr(db, TK_ID, zSchemaName), pE);
+  return pE;
 }
+
+/*
+** Column zName of pTabList->a[iFrom] is being expanded by a "*" and is in
+** the USING clause of a later join, with a RIGHT or FULL JOIN somewhere.
+** Return the expression that the column of the join means: a reference
+** to the column of the left-most table for an INNER or LEFT JOIN, of the
+** right-most table for a RIGHT JOIN, and a coalesce() of the tables for a
+** FULL JOIN, following the rules lookupName() in resolve.c applies to a
+** bare name. Only the tables whose USING clause names zName take part: a
+** later table with a column of the same name that is not joined by USING
+** on it is not part of this column (a bare zName would be ambiguous with
+** it). The references are qualified by schema and table, so that name
+** resolution (and the authorizer) see them as ordinary column references.
+**
+** Return NULL if the expression cannot be built here (a parenthesized
+** join takes part, or OOM); the caller then uses the bare name.
+*/
+static Expr *selectExpandUsingColumn(
+  Parse *pParse,          /* Parsing context */
+  SrcList *pTabList,      /* The FROM clause */
+  int iFrom,              /* Index of the table with the column */
+  const char *zName       /* Name of the column */
+){
+  sqlite3 *db = pParse->db;
+  ExprList *pList = 0;
+  Expr *pE;
+  int m;
+  if( pTabList->a[iFrom].fg.isNestedFrom ) return 0;
+  for(m=iFrom+1; m<pTabList->nSrc; m++){
+    SrcItem *pItem = &pTabList->a[m];
+    if( pItem->fg.isUsing==0 ) continue;
+    if( NEVER(pItem->u3.pUsing==0) ) continue;
+    if( sqlite3IdListIndex(pItem->u3.pUsing, zName)<0 ) continue;
+    if( pItem->fg.isNestedFrom ) return 0;
+  }
+  pE = selectExpandQualifiedColumn(pParse, &pTabList->a[iFrom], zName);
+  pList = sqlite3ExprListAppend(pParse, 0, pE);
+  if( pList==0 || db->mallocFailed ) goto expand_using_fail;
+  for(m=iFrom+1; m<pTabList->nSrc; m++){
+    SrcItem *pItem = &pTabList->a[m];
+    if( pItem->fg.isUsing==0 ) continue;
+    if( NEVER(pItem->u3.pUsing==0) ) continue;
+    if( sqlite3IdListIndex(pItem->u3.pUsing, zName)<0 ) continue;
+    if( (pItem->fg.jointype & JT_RIGHT)==0 ){
+      /* An INNER or LEFT JOIN.  Use the left-most table */
+      continue;
+    }
+    if( (pItem->fg.jointype & JT_LEFT)==0 ){
+      /* A RIGHT JOIN.  Use the right-most table */
+      sqlite3ExprListDelete(db, pList);
+      pList = 0;
+    }
+    pE = selectExpandQualifiedColumn(pParse, pItem, zName);
+    pList = sqlite3ExprListAppend(pParse, pList, pE);
+    if( pList==0 || db->mallocFailed ) goto expand_using_fail;
+  }
+  if( pList->nExpr==1 ){
+    pE = pList->a[0].pExpr;
+    pList->a[0].pExpr = 0;
+    sqlite3ExprListDelete(db, pList);
+  }else{
+    static const Token tkCoalesce = { "coalesce", 8 };
+    pE = sqlite3ExprFunction(pParse, pList, &tkCoalesce, 0);
+    if( pE ) pE->affExpr = SQLITE_AFF_DEFER;
+  }
+  return pE;
 
+expand_using_fail:
+  sqlite3ExprListDelete(db, pList);
+  return 0;
+}
 
