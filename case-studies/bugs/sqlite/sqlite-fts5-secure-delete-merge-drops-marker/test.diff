+#
+#*************************************************************************
+#
+# Tests for secure-delete after a merge that combined a delete marker,
+# written while secure-delete was off, with a newer entry for the same
+# rowid, while an older segment that is not part of the merge still
+# holds an entry for that rowid.
+#
+
+source [file join [file dirname [info script]] fts5_common.tcl]
+ifcapable !fts5 { finish_test ; return }
+set ::testprefix fts5secure10
+
+foreach {tn detail} {
+  1 full
+  2 column
+  3 none
+} {
+foreach {tn2 opts} {
+  1 ""
+  2 ", prefix=1"
+} {
+  set T "$tn.$tn2"
+  reset_db
+
+  # Segment layout before the merge: an older level-1 segment holding
+  # c/1, and two level-0 segments, one with a delete marker for c/1 and
+  # a newer one with a plain c/1 entry. The merge writes the level-0
+  # segments to level 1, after the older segment.
+  do_execsql_test $T.1.0 "
+    CREATE VIRTUAL TABLE t1 USING fts5(x, detail=$detail $opts);
+  "
+  do_execsql_test $T.1.1 {
+    INSERT INTO t1(t1, rank) VALUES('pgsz', 32);
+    INSERT INTO t1(rowid, x) VALUES(1, 'c');
+    INSERT INTO t1(rowid, x) VALUES(2, 'a b d e f g h');
+    INSERT INTO t1(t1) VALUES('optimize');
+    DELETE FROM t1 WHERE rowid=1;
+    INSERT INTO t1(t1, rank) VALUES('secure-delete', 1);
+    INSERT INTO t1(rowid, x) VALUES(1, 'c');
+    INSERT INTO t1(t1, rank) VALUES('usermerge', 2);
+    INSERT INTO t1(t1, rank) VALUES('merge', 1);
+  }
+  do_execsql_test $T.1.2 {
+    SELECT level, count(*) FROM fts5_structure(
+      (SELECT block FROM t1_data WHERE id=10)
+    ) GROUP BY level;
+  } {1 2}
+  do_execsql_test $T.1.3 {
+    DELETE FROM t1 WHERE rowid=1;
+    SELECT rowid FROM t1 WHERE t1 MATCH 'c';
+  } {}
+  do_execsql_test $T.1.4 {
+    INSERT INTO t1(t1) VALUES('integrity-check');
+  }
+
+  # As above, but the delete marker is followed by an entry with the
+  # delete flag set, the level-0 segments are merged by a crisis-merge,
+  # and the rowid is removed by an UPDATE.
+  do_execsql_test $T.2.0 "
+    CREATE VIRTUAL TABLE t2 USING fts5(x, detail=$detail $opts);
+  "
+  do_execsql_test $T.2.1 {
+    INSERT INTO t2(t2, rank) VALUES('pgsz', 32);
+    INSERT INTO t2(t2, rank) VALUES('automerge', 0);
+    INSERT INTO t2(t2, rank) VALUES('crisismerge', 3);
+    INSERT INTO t2(rowid, x) VALUES(1, 'c');
+    INSERT INTO t2(rowid, x) VALUES(2, 'a b d e f g h');
+    INSERT INTO t2(t2) VALUES('optimize');
+    INSERT OR REPLACE INTO t2(rowid, x) VALUES(1, 'c');
+    DELETE FROM t2 WHERE rowid=1;
+    INSERT INTO t2(t2, rank) VALUES('secure-delete', 1);
+    INSERT INTO t2(rowid, x) VALUES(1, 'c');
+  }
+  do_execsql_test $T.2.2 {
+    SELECT level, count(*) FROM fts5_structure(
+      (SELECT block FROM t2_data WHERE id=10)
+    ) GROUP BY level;
+  } {1 2}
+  do_execsql_test $T.2.3 {
+    UPDATE t2 SET x='b' WHERE rowid=1;
+    SELECT rowid FROM t2 WHERE t2 MATCH 'c';
+    SELECT rowid FROM t2 WHERE t2 MATCH 'b';
+  } {1 2}
+  do_execsql_test $T.2.4 {
+    INSERT INTO t2(t2) VALUES('integrity-check');
+  }
+
+  # The older entry, the delete marker and the newer entry are all
+  # merged, into a segment that is not the oldest. The output entry has
+  # the delete flag set. Removing it must not damage the index.
+  do_execsql_test $T.3.0 "
+    CREATE VIRTUAL TABLE t3 USING fts5(x, detail=$detail $opts);
+  "
+  do_execsql_test $T.3.1 {
+    INSERT INTO t3(t3, rank) VALUES('pgsz', 32);
+    INSERT INTO t3(rowid, x) VALUES(5, 'z');
+    INSERT INTO t3(rowid, x) VALUES(6, 'a b d e f g h');
+    INSERT INTO t3(t3) VALUES('optimize');
+    INSERT INTO t3(rowid, x) VALUES(1, 'c');
+    DELETE FROM t3 WHERE rowid=1;
+    INSERT INTO t3(t3, rank) VALUES('secure-delete', 1);
+    INSERT INTO t3(rowid, x) VALUES(1, 'c');
+    INSERT INTO t3(t3, rank) VALUES('usermerge', 3);
+    INSERT INTO t3(t3, rank) VALUES('merge', 1);
+  }
+  do_execsql_test $T.3.2 {
+    SELECT level, count(*) FROM fts5_structure(
+      (SELECT block FROM t3_data WHERE id=10)
+    ) GROUP BY level;
+  } {1 2}
+  do_execsql_test $T.3.3 {
+    DELETE FROM t3 WHERE rowid=1;
+    SELECT rowid FROM t3 WHERE t3 MATCH 'c';
+  } {}
+  do_execsql_test $T.3.4 {
+    INSERT INTO t3(t3) VALUES('integrity-check');
+  }
+  # As case 1, but the merge is incremental and stops just before term
+  # "c". The delete marker for c/1 has already been skipped as a
+  # duplicate of the newer c/1 entry, and its segment is trimmed to
+  # nothing.
+  do_execsql_test $T.4.0 "
+    CREATE VIRTUAL TABLE t4 USING fts5(x, detail=$detail $opts);
+  "
+  do_execsql_test $T.4.1 {
+    INSERT INTO t4(t4, rank) VALUES('pgsz', 32);
+    INSERT INTO t4(rowid, x) VALUES(1, 'c');
+    INSERT INTO t4(rowid, x) VALUES(2, 'm n o p q r s t u v w x y z');
+    INSERT INTO t4(t4) VALUES('optimize');
+    DELETE FROM t4 WHERE rowid=1;
+    INSERT INTO t4(t4, rank) VALUES('secure-delete', 1);
+    INSERT INTO t4(rowid, x) VALUES(1, 'c'), (3, 'aa ab ac ad ae af ag ah');
+    INSERT INTO t4(t4, rank) VALUES('usermerge', 2);
+    INSERT INTO t4(t4, rank) VALUES('merge', 1);
+  }
+  do_execsql_test $T.4.2 {
+    DELETE FROM t4 WHERE rowid=1;
+    SELECT rowid FROM t4 WHERE t4 MATCH 'c';
+  } {}
+  do_execsql_test $T.4.3 {
+    INSERT INTO t4(t4) VALUES('integrity-check');
+  }
+}
+}
+
+finish_test
