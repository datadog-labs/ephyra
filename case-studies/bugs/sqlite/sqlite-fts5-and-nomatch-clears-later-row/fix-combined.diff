   }while( bMatch==0 );
 
   if( pAnd->bNomatch && pAnd!=pExpr->pRoot ){
-    fts5ExprNodeZeroPoslist(pAnd);
+    fts5ExprNodeZeroPoslistAt(pAnd, iLast);
   }
   pAnd->iRowid = iLast;
   return SQLITE_OK;
