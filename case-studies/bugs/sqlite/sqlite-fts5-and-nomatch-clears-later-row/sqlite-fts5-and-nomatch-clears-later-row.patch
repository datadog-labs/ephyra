+#-------------------------------------------------------------------------
+# When an AND node does not match the current row, the position lists
+# of phrases whose nodes have already advanced to a later row must not
+# be cleared, or those phrases report no instances for the later row.
+#
+reset_db
+do_execsql_test 16.0 {
+  CREATE VIRTUAL TABLE t1 USING fts5(a);
+  INSERT INTO t1(rowid, a) VALUES(1, 'x y'), (2, 'x z');
+}
+
+do_execsql_test 16.1 {
+  SELECT rowid, highlight(t1, 0, '[', ']') FROM t1('x AND (z OR "y x")');
+} {2 {[x] [z]}}
+
+do_execsql_test 16.2 {
+  SELECT rowid, highlight(t1, 0, '[', ']')
+  FROM t1('(x AND (z OR "y x")) OR zz');
+} {2 {[x] [z]}}
+
+do_execsql_test 16.3 {
+  SELECT rowid, highlight(t1, 0, '[', ']')
+  FROM t1('(x AND (z OR "y x")) NOT zz');
+} {2 {[x] [z]}}
+
+do_execsql_test 16.4 {
+  SELECT rowid, highlight(t1, 0, '[', ']')
+  FROM t1('(x AND (z OR "y x")) OR zz') WHERE rowid=2;
+} {2 {[x] [z]}}
+
+do_execsql_test 16.5 {
+  SELECT bm25(t1) = (SELECT bm25(t1) FROM t1('x AND (z OR "y x")'))
+  FROM t1('(x AND (z OR "y x")) OR zz');
+} {1}
+
+foreach {tn detail} {1 full 2 column} {
