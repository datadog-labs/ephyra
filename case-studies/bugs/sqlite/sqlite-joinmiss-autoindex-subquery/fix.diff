+      assert( pX->op==TK_EQ || pX->op==TK_IS );
+      if( !sqlite3ExprIsSingleTableConstraint(pX->pRight, pTabList,
+                                              pParent->iFrom, 0) ){
+        break;
+      }
     }
-    return pParent->addrDeleteCont;
+    if( i>=pLoop->nLTerm ){
