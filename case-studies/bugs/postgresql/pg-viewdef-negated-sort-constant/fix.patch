diff --git a/src/test/regress/expected/create_view.out b/src/test/regress/expected/create_view.out
index 053fa56573f..a548397eae2 100644
--- a/src/test/regress/expected/create_view.out
+++ b/src/test/regress/expected/create_view.out
@@ -891,6 +891,35 @@ View definition:
    FROM tt1
   ORDER BY tt1.x1;
 
+-- Test deparsing of ORDER BY / GROUP BY terms that negate a constant: the
+-- grammar folds "- 1" into the constant -1, which would be read back as a
+-- column number
+create view negated_const_sort as
+select distinct on (- '1'::int4) x1, x2, x3 from tt1
+  order by - '1'::int4, - (- '1'::int4), - '1.5'::numeric, + '2'::int4;
+select pg_get_viewdef('negated_const_sort', true);
+                                  pg_get_viewdef                                  
+----------------------------------------------------------------------------------
+  SELECT DISTINCT ON ((- 1::integer)) x1,                                        +
+     x2,                                                                         +
+     x3                                                                          +
+    FROM tt1                                                                     +
+   ORDER BY (- 1::integer), (- (- 1::integer)), (- 1.5::numeric), (+ 2::integer);
+(1 row)
+
+create view negated_const_group as
+select x1, count(*) from tt1
+  group by x1, - '1'::int4, rollup (- (- '2'::int4));
+select pg_get_viewdef('negated_const_group', false);
+                       pg_get_viewdef                       
+------------------------------------------------------------
+  SELECT x1,                                               +
+     count(*) AS count                                     +
+    FROM tt1                                               +
+   GROUP BY x1, (- 1::integer), ROLLUP((- (- 2::integer)));
+(1 row)
+
+drop view negated_const_sort, negated_const_group;
