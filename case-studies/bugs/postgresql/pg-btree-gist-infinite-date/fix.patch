-
+	diff = (double) origentry->lower - (double) newentry->lower;
 	res += Max(diff, 0);
 
 	*result = 0.0;
 
 	if (res > 0)
 	{
-		diff = DatumGetInt32(DirectFunctionCall2(date_mi,
-												 DateADTGetDatum(origentry->upper),
-												 DateADTGetDatum(origentry->lower)));
+		diff = (double) origentry->upper - (double) origentry->lower;
 		*result += FLT_MIN;
-		*result += (float) (res / ((double) (res + diff)));
+		*result += (float) (res / (res + diff));
 		*result *= (FLT_MAX / (((GISTENTRY *) PG_GETARG_POINTER(0))->rel->rd_att->natts + 1));
 	}
 
