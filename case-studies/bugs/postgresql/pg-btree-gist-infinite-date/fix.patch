@@ -91,10 +91,17 @@ gbt_datekey_cmp(const void *a, const void *b, FmgrInfo *flinfo)
 static float8
 gdb_date_dist(const void *a, const void *b, FmgrInfo *flinfo)
 {
+	DateADT		aa = *((const DateADT *) a);
+	DateADT		bb = *((const DateADT *) b);
+	Datum		diff;
+
+	if (DATE_NOT_FINITE(aa) || DATE_NOT_FINITE(bb))
