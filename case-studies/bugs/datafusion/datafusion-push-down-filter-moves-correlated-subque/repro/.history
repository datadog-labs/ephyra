#V2
CREATE TABLE t1 (c0 BIGINT) AS VALUES (1), (3);
CREATE TABLE t2 (c0 BIGINT, c1 VARCHAR) AS VALUES (1, 'x'), (2, 'y');
SELECT * FROM t2 AS a JOIN t1 AS b ON a.c0 = ANY (SELECT c0 FROM t1) ORDER BY b.c0;
CREATE TABLE t1 (c0 BIGINT) AS VALUES (1), (3);
CREATE TABLE t2 (c0 BIGINT, c1 VARCHAR) AS VALUES (1, 'x'), (2, 'y');
SELECT * FROM t2 AS a JOIN t1 AS b ON a.c0 = ANY (SELECT c0 FROM t1) ORDER BY b.c0;
