+# A quantified comparison in a JOIN ON clause becomes EXISTS subqueries
+# correlated on the join inputs; push_down_filter must not move them below an
+# alias or to the side that lacks the correlated column
+statement ok
+CREATE TABLE sq_on_l (c0 BIGINT, c1 VARCHAR) AS VALUES (1, 'x'), (2, 'y');
+
+statement ok
+CREATE TABLE sq_on_r (c0 BIGINT) AS VALUES (1), (3);
+
+query ITI rowsort
+SELECT * FROM sq_on_l AS a JOIN sq_on_r AS b ON a.c0 = ANY (SELECT c0 FROM sq_on_r);
+----
+1 x 1
+1 x 3
+
+query ITI rowsort
+SELECT * FROM sq_on_l AS a JOIN sq_on_r AS b ON b.c0 > ALL (SELECT c0 - 3 FROM sq_on_r);
+----
+1 x 1
+1 x 3
+2 y 1
+2 y 3
+
+query ITI rowsort
+SELECT * FROM sq_on_l AS a JOIN sq_on_r AS b ON a.c0 = b.c0 AND a.c0 = ANY (SELECT c0 FROM sq_on_r);
+----
+1 x 1
+
+statement ok
+DROP TABLE sq_on_l;
+
+statement ok
