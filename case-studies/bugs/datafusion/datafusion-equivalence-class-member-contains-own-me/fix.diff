+# The filter `a.c1 + a.c2 = a.c1` equates an expression with one of its own
+# sub-expressions. It must not be used to rewrite the sort for the join keys
+# `(c1, c2)` into a sort that the join no longer recognizes.
+statement ok
+CREATE TABLE t_nest(c0 BIGINT, c1 BIGINT, c2 BIGINT) AS VALUES (1, 2, 0), (2, 2, 0), (3, 5, 1), (4, NULL, 0);
+
+query I rowsort
+SELECT a.c0 FROM t_nest AS a JOIN t_nest AS b ON a.c1 = b.c1 AND a.c2 = b.c2 WHERE a.c1 + a.c2 = a.c1;
+----
+1
+1
+2
+2
+
+statement ok
+DROP TABLE t_nest;
+
+# `abs(<scalar subquery>)` is constant, and so is the join key equal to it, so
+# no sort is needed below the join.
+statement ok
+CREATE TABLE t_abs(c0 BIGINT, c1 BIGINT) AS VALUES (3, 1), (3, 2), (0, 3);
+
+query I rowsort
+SELECT a.c1 FROM t_abs AS a JOIN t_abs AS b ON a.c0 = b.c0 WHERE abs((SELECT count(*) FROM t_abs)) = a.c0;
+----
+1
+1
+2
+2
+
+statement ok
+DROP TABLE t_abs;
+
