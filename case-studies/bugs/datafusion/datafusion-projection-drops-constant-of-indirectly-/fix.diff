+# A filter makes `upper(c2)` constant on the left side. The constant must
+# survive the projection embedded into the join (which renumbers `c2`), so
+# that the sort that relies on it still satisfies the merge above it.
+statement ok
+CREATE TABLE t0(c0 BIGINT, c1 BIGINT, c2 VARCHAR) AS VALUES (1, 1, 'a'), (2, 1, 'A'), (3, 2, 'b');
+
+query TI
+SELECT upper(a1.c2) AS x0, a2.c1 AS x1 FROM t0 AS a1 LEFT JOIN t0 AS a2 ON a1.c0 = a2.c1
+WHERE upper(a1.c2) = 'A' ORDER BY 1, 2 DESC;
+----
+A 2
+A 1
+A 1
+
+statement ok
+DROP TABLE t0;
+
