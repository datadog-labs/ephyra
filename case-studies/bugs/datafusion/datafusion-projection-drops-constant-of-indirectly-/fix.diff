+    #[test]
+    fn test_project_keeps_constant_of_indirectly_projected_class() -> Result<()> {
+        // - columns: [a, b], "a + b" is constant (e.g. due to a filter).
+        // - projection [b, a] renumbers the columns, so "a + b" is projected
+        //   indirectly and must stay constant.
+        let schema = Arc::new(Schema::new(vec![
+            Field::new("a", DataType::Int32, false),
+            Field::new("b", DataType::Int32, false),
+        ]));
+        let a_plus_b = binary(
+            col("a", &schema)?,
+            Operator::Plus,
+            col("b", &schema)?,
+            &schema,
+        )?;
+        let mut group = EquivalenceGroup::default();
+        group.add_constant(ConstExpr::new(
+            Arc::clone(&a_plus_b),
+            AcrossPartitions::Uniform(Some(ScalarValue::Int32(Some(3)))),
+        ));
+
+        let projected_schema = Arc::new(Schema::new(vec![
+            Field::new("b", DataType::Int32, false),
+            Field::new("a", DataType::Int32, false),
+        ]));
+        let mapping = [
+            (
+                col("b", &schema)?,
+                vec![(col("b", &projected_schema)?, 0)].into(),
+            ),
+            (
+                col("a", &schema)?,
+                vec![(col("a", &projected_schema)?, 1)].into(),
+            ),
+        ]
+        .into_iter()
+        .collect::<ProjectionMapping>();
+
+        let projected = group.project(&mapping);
+        let projected_a_plus_b = binary(
+            col("a", &projected_schema)?,
+            Operator::Plus,
+            col("b", &projected_schema)?,
+            &projected_schema,
+        )?;
+        assert_eq!(
+            projected.is_expr_constant(&projected_a_plus_b),
+            Some(AcrossPartitions::Uniform(Some(ScalarValue::Int32(Some(3)))))
+        );
+
+        Ok(())
+    }
