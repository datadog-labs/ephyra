diff --git a/lib/elixir/lib/module/types/pattern.ex b/lib/elixir/lib/module/types/pattern.ex
index a68caff..483de3e 100644
--- a/lib/elixir/lib/module/types/pattern.ex
+++ b/lib/elixir/lib/module/types/pattern.ex
@@ -816,6 +816,11 @@ defp of_pattern({:%{}, _meta, args}, path, stack, context) do
   defp of_pattern({:<<>>, _meta, args} = node, _path, stack, context) do
     precise? = of_precise_bitstring?(node, context.vars)
     {type, _fail?, context} = Of.bitstring(args, :match, stack, context)
+
+    # The bitstring type does not depend on the segment variable, so refining
+    # the variable in guards does not refine the pattern. We annotate it like
+    # list subpatterns, which makes guards that use it imprecise.
+    context = if precise?, do: annotate_bitstring_subpattern(node, context), else: context
     {type, precise?, context}
   end
 
@@ -1028,6 +1033,12 @@ defp of_precise_bitstring?({:<<>>, _meta, [{:"::", _, [expr, {type, _, _}]}]}, v
 
   defp of_precise_bitstring?(_expr, _vars), do: false
 
+  defp annotate_bitstring_subpattern({:<<>>, _meta, [{:"::", _, [expr, _]}]}, context),
+    do: annotate_bitstring_subpattern(expr, context)
+
+  defp annotate_bitstring_subpattern(var, context) when is_var(var),
+    do: annotate_list_subpattern(var, context)
+
   defp new_var?({_, meta, _} = var, vars) when is_var(var) do
     version = Keyword.fetch!(meta, :version)
     not is_map_key(vars, version)
