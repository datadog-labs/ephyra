+    test "does not deduct bitstrings refined by guards from the next clauses" do
+      files = %{
+        "a.ex" => """
+        defmodule A do
+          def fun(<<x::bitstring>>) when is_binary(x), do: :binary
+          def fun(_), do: :other
+
+          def nil_or_true(<<x::binary>>) when is_nil(x) or x, do: :binary
+          def nil_or_true(_), do: :other
+        end
+        """
+      }
+
+      {modules, _stderr} = with_io(:stderr, fn -> compile_modules(files) end)
+      exports = read_chunk(modules[A]).exports
+
+      {_, %{sig: {:infer, _, clauses}}} = List.keyfind(exports, {:fun, 1}, 0)
+
+      assert Enum.any?(clauses, fn {[domain], return} ->
+               subtype?(bitstring(), domain) and subtype?(atom([:other]), return)
+             end)
+
+      {_, %{sig: {:infer, _, clauses}}} = List.keyfind(exports, {:nil_or_true, 1}, 0)
+
+      assert Enum.any?(clauses, fn {[domain], return} ->
+               subtype?(binary(), domain) and subtype?(atom([:other]), return)
+             end)
+    end
+
