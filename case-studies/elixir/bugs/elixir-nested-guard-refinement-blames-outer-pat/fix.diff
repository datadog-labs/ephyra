+    {%{vars: guard_vars, changed: changed}, context} = pop_pattern_info(context)
+
+    # Variables defined before the clause may be refined by the guard,
+    # and we propagate it to their dependencies. However, if propagation
+    # fails, it means the guard cannot succeed, not that the outer pattern
+    # (which has already matched) does not match, so we don't report it.
+    {outer, inner} = Enum.split_with(Map.keys(changed), &is_map_key(vars, &1))
+    context = of_changed(inner, stack, context)
+    %{failed: failed} = context
