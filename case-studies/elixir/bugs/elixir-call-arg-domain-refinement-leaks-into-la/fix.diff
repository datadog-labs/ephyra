+    test "refines args after all args are evaluated" do
+      assert typecheck!(
+               [x],
+               Map.put(
+                 x,
+                 :key,
+                 case x do
+                   [_ | _] -> throw(:list)
+                   _ -> :value
+                 end
+               )
+             ) == dynamic(open_map(key: {term(), false}))
+
+      assert typecheck!(
+               [x],
+               (
+                 Map.put(x, :key, x)
+                 x
+               )
+             ) == dynamic(open_map())
+
+      assert typeerror!([x], Map.put(x, :key, hd([_ | _] = x))) =~
+               "incompatible types given to Map.put/3"
+    end
+
     test "send returns the message" do
