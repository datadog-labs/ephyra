@@ -416,6 +416,56 @@ def remote(mod, fun, args, expected, expr, stack, context, of_fun) do
     end
   end
 
+  # Arguments are evaluated before the call, so refining a variable by the domain
+  # of an argument must not be visible to the arguments after it, as in
+  # `Map.put(map, :key, case map do ... end)`. Variables given as arguments and
+  # used again by a later argument are refined once all arguments are checked.
+  # Guards cannot observe evaluation order: a failing argument fails the guard.
+  defp of_args(args, domain, expr, stack, context, of_fun) do
+    case :erlang.fun_info(of_fun, :module) do
+      {:module, Module.Types.Pattern} ->
+        zip_map_reduce(args, domain, context, &of_fun.(&1, &2, expr, stack, &3))
+
+      _ ->
+        deferred = deferred_args(args)
+
+        {types, context} =
+          zip_map_reduce(args, Enum.zip(domain, deferred), context, fn
+            arg, {_type, true}, context -> of_fun.(arg, term(), expr, stack, context)
+            arg, {type, false}, context -> of_fun.(arg, type, expr, stack, context)
+          end)
+
+        if true in deferred do
+          zip_map_reduce(Enum.zip([args, types, deferred]), domain, context, fn
+            {arg, _type, true}, type, context -> of_fun.(arg, type, expr, stack, context)
+            {_arg, type, false}, _domain, context -> {type, context}
+          end)
+        else
+          {types, context}
+        end
+    end
+  end
+
+  defp deferred_args([{_, meta, _} = var | args]) when is_var(var) do
+    version = Keyword.get(meta, :version)
+    [version != nil and Enum.any?(args, &uses_version?(&1, version)) | deferred_args(args)]
+  end
+
+  defp deferred_args([_ | args]), do: [false | deferred_args(args)]
+  defp deferred_args([]), do: []
+
+  defp uses_version?(ast, version) do
+    ast
+    |> Macro.prewalk(false, fn
+      {_, meta, _} = var, false when is_var(var) ->
+        {var, Keyword.get(meta, :version) == version}
+
+      node, acc ->
+        {node, acc}
+    end)
+    |> elem(1)
+  end
+
