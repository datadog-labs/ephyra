+++ b/lib/elixir/test/elixir/module/types/expr_test.exs
@@ -1812,6 +1812,12 @@ test "min/max does not refine discarded arguments from the expected type" do
              ) == opt_union(integer(), dynamic(opt_union(integer(), binary())))
     end
 
+    test "min/max with a dynamic argument returns a gradual type" do
+      assert typedyn!([x], min(x, true)) == dynamic()
+      assert typedyn!([x], 1 * min(x, true)) == dynamic(opt_union(integer(), float()))
+      assert typedyn!([x], max(x, :a) + 1) == dynamic(opt_union(integer(), float()))
+    end
+
     test "does not warn when numbers nested in containers coerce" do
       # `{1} == {1.0}` is true at runtime, and `[1] < [2.0]` is not constant,
       # even though the container types are disjoint as sets.
