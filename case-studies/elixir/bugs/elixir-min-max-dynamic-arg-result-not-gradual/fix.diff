diff --git a/lib/elixir/lib/module/types/apply.ex b/lib/elixir/lib/module/types/apply.ex
index ad20852..5e124bd 100644
--- a/lib/elixir/lib/module/types/apply.ex
+++ b/lib/elixir/lib/module/types/apply.ex
@@ -469,9 +469,11 @@ defp do_remote(:erlang, name, [left, right], _expected, expr, stack, context, of
     # Either argument may be discarded based on term ordering, so the expected
     # type imposes no restriction on either argument nor on the result: all we
     # know is that the result is one of the two, so it is always their union.
+    # Which one is returned depends on both values, so when either argument
+    # is gradual, the result is gradual too.
     {left_type, context} = of_fun.(left, term(), expr, stack, context)
     {right_type, context} = of_fun.(right, term(), expr, stack, context)
-    result = opt_union(left_type, right_type)
+    result = return(opt_union(left_type, right_type), [left_type, right_type], stack)
 
     if error = mismatched_ordered_comparison(left_type, right_type, stack) do
       remote_error(error, :erlang, name, 2, expr, stack, context)
diff --git a/lib/elixir/test/elixir/module/types/expr_test.exs b/lib/elixir/test/elixir/module/types/expr_test.exs
