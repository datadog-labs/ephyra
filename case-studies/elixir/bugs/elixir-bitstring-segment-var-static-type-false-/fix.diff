diff --git a/lib/elixir/lib/module/types/of.ex b/lib/elixir/lib/module/types/of.ex
index 922a100..e7de2e0 100644
--- a/lib/elixir/lib/module/types/of.ex
+++ b/lib/elixir/lib/module/types/of.ex
@@ -698,6 +698,11 @@ defp bitstring_segment({:"::", meta, [left, right]}, kind, args, stack, context)
 
     {actual, context} =
       case kind do
+        # A bitstring segment may bind either a binary or a non-binary
+        # bitstring, which is only known at runtime, so it is gradual.
+        :match when is_var(left) and alignment_type == :bitstring ->
+          Module.Types.Pattern.of_match_var(left, dynamic(type), expr, stack, context)
+
         :match ->
           Module.Types.Pattern.of_match_var(left, type, expr, stack, context)
 
